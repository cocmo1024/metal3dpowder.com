---
import { getCollection } from 'astro:content';
import ContentHub from '../../components/ContentHub.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBlogPostPath, sortBlogPosts, type BlogPost } from '../../data/blog';
import { applicationHubs, type HubDefinition } from '../../data/contentHubs';
import { getProductsForHub } from '../../data/productRoutes';
import { getProductPath } from '../../data/products';
import { buildBreadcrumbSchema, buildCollectionPageSchema } from '../../data/seo';

interface Props {
  hub: HubDefinition;
}

export function getStaticPaths() {
  return applicationHubs.map((hub) => ({
    params: { slug: hub.slug },
    props: { hub },
  }));
}

const { hub } = Astro.props;
const allPosts = sortBlogPosts(await getCollection('blog'));
const postMap = new Map(allPosts.map((post) => [post.id, post]));
const posts = hub.postIds.map((id) => postMap.get(id)).filter((post): post is BlogPost => Boolean(post));
const relatedProducts = getProductsForHub(hub);
const canonical = `/applications/${hub.slug}/`;
const seoTitle = `${hub.title}: Metal Powder Selection`;
const pageHeading = `${hub.title} metal powder selection`;
const metaDescription = `Metal powder selection for ${hub.title}: compare alloy grades, AM process fit, service requirements, and RFQ evidence.`;
const siteUrl = Astro.site ?? new URL('https://metal3dpowder.com');
const breadcrumbItems = [
  { name: 'Home', path: '/' },
  { name: 'Applications', path: '/applications/' },
  { name: hub.title },
];
const schema = [
  buildCollectionPageSchema({
    site: siteUrl,
    path: canonical,
    name: pageHeading,
    description: metaDescription,
    items: [
      ...relatedProducts.map((product) => ({ name: product.name, path: getProductPath(product) })),
      ...posts.map((post) => ({ name: post.data.title, path: getBlogPostPath(post) })),
    ],
  }),
  buildBreadcrumbSchema(siteUrl, breadcrumbItems),
];
---

<BaseLayout title={seoTitle} description={metaDescription} canonical={canonical} schema={schema}>
  <SiteHeader pathname={Astro.url.pathname} />
  <ContentHub
    breadcrumbItems={breadcrumbItems}
    eyebrow="Application center"
    title={pageHeading}
    description={hub.description}
    products={relatedProducts}
    productsTitle={`Alloy grades to evaluate for ${hub.title}`}
    posts={posts}
    postsTitle={`Engineering guides for ${hub.title}`}
    intentLayer="application"
  />
  <SiteFooter />
</BaseLayout>
