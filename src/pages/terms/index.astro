---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { buildBreadcrumbSchema } from '../../data/seo';
import { siteInfo } from '../../data/site';

const title = 'Terms of Service | Metal 3D Powder';
const description =
  'Terms of service for Metal 3D Powder covering reference-only content, acceptable use, quotation validity, and liability limits.';
const siteUrl = Astro.site ?? new URL('https://metal3dpowder.com');
const schema = [buildBreadcrumbSchema(siteUrl, [{ name: 'Home', path: '/' }, { name: 'Terms' }])];
---

<BaseLayout title={title} description={description} canonical="/terms/" schema={schema}>
  <SiteHeader pathname={Astro.url.pathname} />

  <main class="page-shell content-page document-page">
    <section class="page-intro">
      <p class="eyebrow">Terms</p>
      <h1>Reference content, acceptable use, and quotation validity.</h1>
      <p>Last updated: July 23, 2026. These terms explain how catalog, technical, partner, and RFQ information may be used and when commercial terms become binding.</p>
    </section>

    <section class="surface-card surface-card--padded rich-copy">
      <h2>Reference-only website content</h2>
      <p>
        Product pages, cards, articles, FAQ content, process guidance, partner information, and engineering notes are
        general selection and reference information. They do not by themselves create a contractual commitment,
        engineering guarantee, reserved inventory, certification, or formal commercial offer.
      </p>

      <h2>Catalog, availability, and technical values</h2>
      <p>
        A powder appearing in the catalog does not prove current stock, fixed price, lead time, production capacity,
        source, lot, document availability, or fitness for a specific machine or finished part. Particle-size ranges,
        processes, applications, and public data are selection starting points unless the formal quotation states
        otherwise.
      </p>

      <h2>Acceptable use</h2>
      <p>
        Users may browse and reference the website for legitimate business or research purposes. Unlawful access,
        interference with the site, abusive scraping, or misuse of the content is not permitted.
      </p>

      <h2>Quotations and commercial terms</h2>
      <p>
        An online submission reference confirms only that the RFQ service accepted the submission for review. It does not
        confirm feasibility, source, lot, price, lead time, or acceptance. Final specifications and commercial terms are
        valid only when issued through the official corporate email:
        <a class="inline-link" href={`mailto:${siteInfo.email}`}>{siteInfo.email}</a>.
      </p>

      <h2>Partner, certificate, and document boundaries</h2>
      <p>
        A partner name, public factory image, equipment description, typical data set, certificate, sample report, or
        other source material applies only to its stated entity, site, scope, date, process, grade, and lot. It must not
        be interpreted as a universal claim for every powder route shown on this website.
      </p>

      <h2>RFQ submissions and restricted data</h2>
      <p>
        Users must have the right to submit all information they provide. The online form accepts text only. Do not
        enter export-controlled, classified, personal medical, customer-restricted, malicious, or unlawful content
        before an approved handling agreement and separate channel are in place.
      </p>

      <h2>Intellectual property</h2>
      <p>
        Website text, graphics, and technical presentation remain protected content. Reproduction or commercial reuse
        requires prior permission unless otherwise allowed by applicable law.
      </p>

      <h2>Disclaimers and liability limits</h2>
      <p>
        Buyers remain responsible for independent verification before using information for material selection,
        incoming acceptance, printing, heat treatment, machining, inspection, regulatory release, or procurement.
        Powder conformity does not qualify a finished part. To the extent permitted by law, the site owner is not liable
        for losses caused by reliance on general website content without project-specific confirmation.
      </p>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
