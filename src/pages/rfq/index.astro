---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RfqForm from '../../components/RfqForm.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { buildBreadcrumbSchema, buildContactPageSchema } from '../../data/seo';

const title = 'Metal Powder RFQ | Grade, PSD, Documents and Delivery';
const description =
  'Submit a structured metal powder RFQ with alloy, process, PSD, quantity, destination, evidence, packaging, and delivery requirements.';
const siteUrl = Astro.site ?? new URL('https://metal3dpowder.com');
const schema = [
  buildBreadcrumbSchema(siteUrl, [{ name: 'Home', path: '/' }, { name: 'Powder RFQ' }]),
  buildContactPageSchema({
    site: siteUrl,
    path: '/rfq/',
    name: title,
    description,
  }),
];
---

<BaseLayout title={title} description={description} canonical="/rfq/" schema={schema}>
  <SiteHeader pathname={Astro.url.pathname} />

  <main class="rfq-page">
    <section class="rfq-hero">
      <div class="page-shell rfq-hero__inner">
        <div>
          <p class="eyebrow">Powder request for quotation</p>
          <h1>Turn a material name into a buyable powder specification.</h1>
          <p>
            A credible powder quote needs more than “Ti64” or “316L.” Submit the process, particle-size target, quantity,
            destination, timing, documents, and acceptance boundary in one structured request.
          </p>
        </div>
        <aside>
          <strong>What happens next</strong>
          <ol>
            <li>Technical requirement triage</li>
            <li>Source and available-lot confirmation</li>
            <li>Documents, packaging, and logistics review</li>
            <li>Formal commercial response by email</li>
          </ol>
        </aside>
      </div>
    </section>

    <section class="rfq-proof">
      <div class="page-shell">
        <article>
          <span>Multiple grades</span>
          <strong>One RFQ list</strong>
        </article>
        <article>
          <span>Supply status</span>
          <strong>Confirmed by lot</strong>
        </article>
        <article>
          <span>Evidence</span>
          <strong>Matched to source</strong>
        </article>
        <article>
          <span>Formal terms</span>
          <strong>Issued by corporate email</strong>
        </article>
      </div>
    </section>

    <section class="page-shell rfq-form-wrap">
      <RfqForm />
    </section>

    <section class="page-shell rfq-boundaries" aria-labelledby="rfq-boundaries-title">
      <div>
        <p class="eyebrow">Before sharing sensitive information</p>
        <h2 id="rfq-boundaries-title">Use the form for technical scope, not controlled project disclosure.</h2>
      </div>
      <div class="rfq-boundaries__grid">
        <article>
          <strong>Do not enter</strong>
          <p>Export-controlled, classified, personal medical, or customer-restricted information without an approved handling agreement.</p>
        </article>
        <article>
          <strong>Qualification ownership</strong>
          <p>Powder documents support material acceptance; they do not release a printed or finished part.</p>
        </article>
        <article>
          <strong>Alternative channel</strong>
          <p>
            This form accepts text only. Contact
            <a href="mailto:info@szcomo.com">info@szcomo.com</a> if a separate document channel is required.
          </p>
        </article>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .rfq-page {
    gap: 0;
  }

  .rfq-hero {
    color: #fff;
    background:
      linear-gradient(90deg, rgba(7, 27, 47, 0.98), rgba(7, 27, 47, 0.82)),
      radial-gradient(circle at 82% 12%, rgba(71, 145, 211, 0.4), transparent 28rem);
  }

  .rfq-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(18rem, 0.7fr);
    gap: 3rem;
    align-items: end;
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
  }

  .rfq-hero__inner > div {
    display: grid;
    gap: 0.9rem;
  }

  .rfq-hero .eyebrow {
    color: #9ec4e1;
  }

  .rfq-hero h1 {
    max-width: 54rem;
    margin: 0;
    color: #fff;
    font-size: clamp(2.7rem, 6.2vw, 5.7rem);
    line-height: 0.96;
    letter-spacing: -0.055em;
  }

  .rfq-hero__inner > div > p:last-child {
    max-width: 49rem;
    margin: 0;
    color: #bfd0de;
    font-size: 1.02rem;
    line-height: 1.72;
  }

  .rfq-hero aside {
    display: grid;
    gap: 0.8rem;
    padding: 1.2rem;
    border-top: 3px solid var(--accent);
    background: rgba(255, 255, 255, 0.07);
    backdrop-filter: blur(12px);
  }

  .rfq-hero aside strong {
    font-size: 0.92rem;
  }

  .rfq-hero aside ol {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding-left: 1.1rem;
    color: #b8cad8;
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .rfq-proof {
    border-bottom: 1px solid var(--line);
    background: var(--surface);
  }

  .rfq-proof > div {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .rfq-proof article {
    display: grid;
    gap: 0.2rem;
    padding: 1rem 1.1rem;
    border-left: 1px solid var(--line);
  }

  .rfq-proof article:last-child {
    border-right: 1px solid var(--line);
  }

  .rfq-proof span {
    color: var(--muted);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .rfq-proof strong {
    font-size: 0.86rem;
  }

  .rfq-form-wrap {
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  .rfq-boundaries {
    display: grid;
    gap: 1.5rem;
    margin-bottom: 1rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface-soft);
  }

  .rfq-boundaries > div:first-child {
    display: grid;
    gap: 0.45rem;
  }

  .rfq-boundaries h2 {
    max-width: 55rem;
    margin: 0;
    font-size: clamp(1.65rem, 3vw, 2.4rem);
    letter-spacing: -0.035em;
  }

  .rfq-boundaries__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .rfq-boundaries article {
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: var(--surface);
  }

  .rfq-boundaries article strong {
    font-size: 0.88rem;
  }

  .rfq-boundaries article p {
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.55;
  }

  .rfq-boundaries article a {
    color: var(--brand);
    font-weight: 700;
  }

  @media (max-width: 820px) {
    .rfq-hero__inner {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .rfq-hero aside {
      max-width: 30rem;
    }

    .rfq-proof > div,
    .rfq-boundaries__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 540px) {
    .rfq-proof > div,
    .rfq-boundaries__grid {
      grid-template-columns: 1fr;
    }

    .rfq-proof article {
      border-right: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
    }
  }
</style>
