---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleDecisionGuide from '../../../components/ArticleDecisionGuide.astro';
import ArticleEvidence from '../../../components/ArticleEvidence.astro';
import BlogPostGrid from '../../../components/BlogPostGrid.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ProductRouteGrid from '../../../components/ProductRouteGrid.astro';
import RfqCta from '../../../components/RfqCta.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import {
  buildBreadcrumbSchema,
  buildPublisherSchema,
  defaultOgImagePath,
} from '../../../data/seo';
import {
  blogAuthorName,
  blogAuthorPath,
  blogCategoryPath,
  estimateReadingMinutes,
  getAdjacentBlogPosts,
  getBlogPostPath,
  getBlogPostImage,
  getRelatedBlogPosts,
  sortBlogPosts,
} from '../../../data/blog';
import { getHubPath, getPostHubs, knowledgePostIds } from '../../../data/contentHubs';
import { getArticleDecisionGuide } from '../../../data/articleDecisions';
import { getProductsForPost } from '../../../data/productRoutes';
import { siteInfo } from '../../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = sortBlogPosts(await getCollection('blog'));
const { previousPost, nextPost } = getAdjacentBlogPosts(allPosts, post.id);
const relatedPosts = getRelatedBlogPosts(allPosts, post, 6);
const topicHubs = getPostHubs(post.id);
const relatedProducts = getProductsForPost(post.id);
const isKnowledgePost = knowledgePostIds.includes(post.id);
const decisionGuide = getArticleDecisionGuide(post.id);
const decisionCopy = decisionGuide
  ? [
      decisionGuide.title,
      decisionGuide.introduction,
      ...decisionGuide.checks.flatMap((check) => [check.label, check.question]),
      decisionGuide.verification ?? '',
      decisionGuide.acceptance,
    ].join(' ')
  : '';
const readingMinutes = estimateReadingMinutes(`${post.body ?? ''} ${decisionCopy}`);
const formatter = new Intl.DateTimeFormat('en-US', { dateStyle: 'long' });
const topicHubLabel = (group: string) =>
  group === 'materials' ? 'Material guide' : group === 'applications' ? 'Application guide' : 'Process guide';

const canonical = getBlogPostPath(post);
const pageTitle =
  `${post.data.title} | ${siteInfo.brand}`.length <= 72
    ? `${post.data.title} | ${siteInfo.brand}`
    : post.data.title;
const siteUrl = Astro.site ?? new URL('https://metal3dpowder.com');
const publishedIso = post.data.pubDate.toISOString();
const modifiedIso = (post.data.updatedDate ?? post.data.pubDate).toISOString();
const articleImage = getBlogPostImage(post);
const articleImageUrl = new URL(articleImage, siteUrl).toString();
const hasSpecificArticleImage = articleImage !== defaultOgImagePath;
const breadcrumbItems = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: blogCategoryPath },
  { name: post.data.title },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    articleSection: post.data.category,
    keywords: post.data.tags.join(', '),
    url: new URL(canonical, siteUrl).toString(),
    inLanguage: 'en',
    datePublished: publishedIso,
    dateModified: modifiedIso,
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': `${new URL(canonical, siteUrl).toString()}#webpage`,
    },
    author: {
      '@type': 'Organization',
      name: blogAuthorName,
      url: new URL(blogAuthorPath, siteUrl).toString(),
    },
    ...(hasSpecificArticleImage ? { image: [articleImageUrl] } : {}),
    publisher: buildPublisherSchema(siteUrl),
  },
  buildBreadcrumbSchema(siteUrl, breadcrumbItems),
];
---

<BaseLayout
  title={pageTitle}
  description={post.data.description}
  author={blogAuthorName}
  canonical={canonical}
  ogImage={articleImage}
  ogImageAlt={hasSpecificArticleImage ? post.data.title : 'Metal powder sourcing and engineering knowledge'}
  ogType="article"
  extraMeta={[
    { property: 'article:published_time', content: publishedIso },
    { property: 'article:modified_time', content: modifiedIso },
    { property: 'article:section', content: post.data.category },
    ...post.data.tags.map((tag) => ({ property: 'article:tag', content: tag })),
  ]}
  schema={schema}
>
  <SiteHeader pathname={Astro.url.pathname} />

  <main id="main-content" class="page-shell article-page" data-intent-layer="technical-guide">
    <article class="article">
      <Breadcrumbs items={breadcrumbItems} />

      <header class="article-header">
        <h1>{post.data.title}</h1>

        <div class="article-meta">
          <span>Technical guide</span>
          <span>{post.data.category}</span>
          <span>Reviewed by <a href={`${blogAuthorPath}#editorial-standards`}>{blogAuthorName}</a></span>
          <span>{formatter.format(post.data.pubDate)}</span>
          <span>{readingMinutes} min read</span>
        </div>
      </header>

      <section class="article-summary" aria-labelledby="article-summary-title">
        <h2 id="article-summary-title">Summary</h2>
        <p>{post.data.description}</p>
      </section>

      <section class="article-content" data-editorial-content>
        <Content />
      </section>

      <ArticleDecisionGuide postId={post.id} />

      <ArticleEvidence category={post.data.category} />

      <ProductRouteGrid
        products={relatedProducts}
        title="Commercial alloy-grade pages for quotation"
        description="This article supports research and selection intent. Continue to the grade owner page for international designations, process and PSD inputs, supplier and price intent, document scope, and the structured RFQ."
      />

      <RfqCta context={post.data.title} />

      {
        topicHubs.length || isKnowledgePost ? (
          <section class="article-paths" aria-labelledby="article-paths-title">
            <h2 id="article-paths-title">Related technical topics</h2>
            <p>Continue with related material, process, and application guidance.</p>
            <div class="article-paths__links">
              {isKnowledgePost ? (
                <a href="/knowledge/">
                  <span>Knowledge base</span>
                  <strong>Metal Powder Knowledge Base</strong>
                </a>
              ) : null}
              {topicHubs.map((hub) => (
                <a href={getHubPath(hub)}>
                  <span>{topicHubLabel(hub.group)}</span>
                  <strong>{hub.title}</strong>
                </a>
              ))}
            </div>
          </section>
        ) : null
      }

      <section class="article-tags" aria-labelledby="article-tags-title">
        <h2 id="article-tags-title">Tags</h2>
        <div class="article-tags__list">
          {post.data.tags.map((tag) => (
            <span>{tag}</span>
          ))}
        </div>
      </section>

      <nav class="article-pagination" aria-label="Article pagination">
        {previousPost ? (
          <a class="article-pagination__link" href={getBlogPostPath(previousPost)}>
            <span>Previous article</span>
            <strong>{previousPost.data.title}</strong>
          </a>
        ) : null}

        {nextPost ? (
          <a class="article-pagination__link" href={getBlogPostPath(nextPost)}>
            <span>Next article</span>
            <strong>{nextPost.data.title}</strong>
          </a>
        ) : null}
      </nav>

      {
        relatedPosts.length ? (
          <section class="article-related" aria-labelledby="article-related-title">
            <h2 id="article-related-title">Related Articles</h2>
            <BlogPostGrid posts={relatedPosts} ariaLabel="Related articles" headingLevel={3} />
          </section>
        ) : null
      }
    </article>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .article-page {
    padding-block: var(--page-padding-block);
  }

  .article {
    display: grid;
    gap: var(--page-gap);
    max-width: 920px;
    margin-inline: auto;
  }

  .article-header,
  .article-summary,
  .article-paths,
  .article-tags,
  .article-pagination,
  .article-related {
    display: grid;
    gap: 0.8rem;
  }

  .article-header h1,
  .article-summary h2,
  .article-paths h2,
  .article-tags h2,
  .article-related h2,
  .article-content :global(h2),
  .article-content :global(h3) {
    margin: 0;
  }

  .article-header h1 {
    width: 100%;
    max-width: none;
    font-size: clamp(2.15rem, 3vw, 3.15rem);
    line-height: 1.08;
    letter-spacing: var(--title-tracking);
    font-weight: 760;
    text-wrap: pretty;
    word-break: normal;
    overflow-wrap: normal;
    hyphens: none;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.05rem;
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 650;
    text-transform: uppercase;
    letter-spacing: 0.11em;
  }

  .article-meta a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .article-summary {
    padding: var(--card-padding);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--card-bg);
    box-shadow: var(--shadow-card);
  }

  .article-summary h2,
  .article-paths h2,
  .article-tags h2,
  .article-related h2 {
    font-size: 0.9rem;
    font-weight: 760;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .article-summary p,
  .article-paths p,
  .article-content :global(p),
  .article-content :global(li) {
    margin: 0;
    color: var(--copy);
    line-height: var(--body-leading);
    font-size: 1.06rem;
  }

  .article-content {
    display: grid;
    gap: 0;
  }

  .article-content :global(h2),
  .article-content :global(h3) {
    margin-top: 2.35rem;
    margin-bottom: 0.8rem;
    letter-spacing: -0.02em;
  }

  .article-content :global(h2) {
    font-size: clamp(1.5rem, 2.2vw, 1.92rem);
    line-height: 1.16;
    font-weight: 750;
  }

  .article-content :global(h3) {
    font-size: clamp(1.14rem, 1.5vw, 1.28rem);
    line-height: 1.3;
    font-weight: 730;
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin: 0;
    padding-left: 1.35rem;
  }

  .article-content :global(table) {
    display: block;
    width: 100%;
    max-width: 100%;
    margin: 1rem 0 0;
    overflow-x: auto;
    border-collapse: collapse;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    font-size: 0.98rem;
    line-height: 1.6;
  }

  .article-content :global(th),
  .article-content :global(td) {
    min-width: 9rem;
    padding: 0.85rem 0.95rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  .article-content :global(th:last-child),
  .article-content :global(td:last-child) {
    border-right: 0;
  }

  .article-content :global(tr:last-child td) {
    border-bottom: 0;
  }

  .article-content :global(th) {
    color: var(--text);
    background: var(--brand-soft);
    font-weight: 700;
  }

  .article-content :global(td) {
    color: var(--copy);
  }

  .article-content :global(blockquote) {
    display: grid;
    gap: 0.45rem;
    margin: 1rem 0 0;
    padding: var(--card-padding);
    border-left: 3px solid var(--accent);
    border-radius: 0 var(--radius-card) var(--radius-card) 0;
    background: var(--surface-soft);
  }

  .article-content :global(blockquote p) {
    margin: 0;
  }

  .article-content :global(a) {
    color: var(--accent);
  }

  .article-content :global(.article-figure) {
    display: grid;
    gap: 0.55rem;
    margin: 1.35rem 0 0;
  }

  .article-content :global(.article-figure img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--card-bg);
  }

  .article-content :global(.article-figure figcaption) {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .article-paths {
    padding-block: 1.1rem;
    border-block: 1px solid var(--line);
  }

  .article-paths__links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 0.65rem;
  }

  .article-paths__links a {
    display: grid;
    gap: 0.18rem;
    min-height: 5rem;
    padding: 0.78rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    color: var(--text);
    background: var(--surface-soft);
  }

  .article-paths__links a:hover {
    border-color: color-mix(in srgb, var(--brand) 35%, var(--line));
    color: var(--text);
  }

  .article-paths__links span {
    color: var(--muted);
    font-size: 0.86rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .article-paths__links strong {
    font-size: 1.02rem;
    line-height: 1.32;
    letter-spacing: -0.01em;
  }

  .article-tags__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .article-tags__list span {
    display: inline-flex;
    align-items: center;
    min-height: 2.35rem;
    padding: 0.45rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    background: var(--surface-soft);
    font-size: 0.92rem;
  }

  .article-pagination__link:hover {
    border-color: color-mix(in srgb, var(--brand) 35%, var(--line));
    color: var(--text);
  }

  .article-pagination {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .article-pagination__link {
    display: grid;
    gap: 0.35rem;
    padding: var(--card-padding);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--card-bg);
  }

  .article-pagination__link span {
    color: var(--muted);
    font-size: 0.88rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .article-pagination__link strong {
    font-size: 1.02rem;
    line-height: 1.35;
    letter-spacing: -0.015em;
    font-weight: 700;
  }

  @media (max-width: 720px) {
    .article-page {
      padding-block: var(--mobile-page-padding-block);
    }

    .article {
      gap: var(--mobile-page-gap);
    }

    .article-header h1 {
      font-size: clamp(1.9rem, 8.2vw, 2.45rem);
      line-height: 1.1;
      letter-spacing: -0.02em;
    }

    .article-content :global(h2) {
      font-size: 1.4rem;
    }

    .article-content :global(h3) {
      font-size: 1.15rem;
    }

    .article-pagination {
      grid-template-columns: 1fr;
    }
  }
</style>
