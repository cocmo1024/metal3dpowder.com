---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductCard from '../../components/ProductCard.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import {
  getProductPath,
  productApplications,
  productFamilies,
  productProcesses,
  products,
} from '../../data/products';
import {
  extendedAlloyMatrix,
  extendedGradeCount,
  processPowderWindows,
} from '../../data/powderCapabilities';
import { buildBreadcrumbSchema, buildCollectionPageSchema } from '../../data/seo';
import { getProductSearchIntent } from '../../data/searchIntent';

const title = 'Metal Powder by Alloy Grade for 3D Printing & AM | Supplier RFQ';
const description =
  'Find metal powder by exact alloy grade, international designation, LPBF, EBM, DED, MIM or binder jet process, PSD, price intent, and supplier RFQ.';
const siteUrl = Astro.site ?? new URL('https://metal3dpowder.com');
const breadcrumbItems = [{ name: 'Home', path: '/' }, { name: 'Powder catalog' }];
const schema = [
  buildBreadcrumbSchema(siteUrl, breadcrumbItems),
  buildCollectionPageSchema({
    site: siteUrl,
    path: '/products/',
    name: title,
    description,
    items: products.map((product) => ({
      name: getProductSearchIntent(product.id).primaryQuery,
      path: getProductPath(product),
    })),
  }),
];
---

<BaseLayout title={title} description={description} canonical="/products/" schema={schema}>
  <SiteHeader pathname={Astro.url.pathname} />

  <main id="main-content" class="catalog-page" data-intent-layer="alloy-grade-catalog">
    <Breadcrumbs items={breadcrumbItems} contained />

    <section class="catalog-hero">
      <div class="catalog-hero__inner page-shell">
        <div>
          <p class="eyebrow">Powder catalog</p>
          <h1>Metal powder by exact alloy grade for 3D printing and AM.</h1>
          <p>
            Start with the grade buyers actually specify—such as Ti6Al4V, IN718, 316L, AlSi10Mg, CuCrZr, or CoCrMo—then
            narrow by process, PSD, standard, evidence package, quantity, and destination. Stock, pricing, and final
            specifications are confirmed with each quotation.
          </p>
        </div>
        <aside>
          <strong>{products.length} core grade-owner pages</strong>
          <span>{extendedGradeCount} additional grade designations · {processPowderWindows.length} process families</span>
          <a href="/rfq/">Open RFQ list <span data-rfq-count data-empty>0</span> →</a>
        </aside>
      </div>
    </section>

    <section class="catalog-shell page-shell" aria-labelledby="catalog-results-title">
      <div class="filter-panel" data-catalog-filters>
        <div class="filter-panel__top">
          <div>
            <p class="eyebrow">Product finder</p>
            <h2>Filter by grade, alias, process, and application.</h2>
          </div>
          <button type="button" data-filter-reset>Clear filters</button>
        </div>

        <div class="filter-grid">
          <label class="filter-search">
            <span>Search grade or designation</span>
            <input
              type="search"
              placeholder="Examples: Ti64, Grade 23, IN718, S31603, C18150"
              autocomplete="off"
              data-filter-search
            />
          </label>

          <label>
            <span>Alloy family</span>
            <select data-filter-family>
              <option value="">All families</option>
              {productFamilies.map((family) => <option value={family.id}>{family.label}</option>)}
            </select>
          </label>

          <label>
            <span>Process</span>
            <select data-filter-process>
              <option value="">All processes</option>
              {productProcesses.map((process) => <option value={process}>{process}</option>)}
            </select>
          </label>

          <label>
            <span>Application market</span>
            <select data-filter-application>
              <option value="">All applications</option>
              {productApplications.map((application) => <option value={application}>{application}</option>)}
            </select>
          </label>
        </div>
      </div>

      <div class="catalog-results__head">
        <div>
          <p class="eyebrow">Search results</p>
          <h2 id="catalog-results-title"><span data-result-count>{products.length}</span> alloy-grade pages</h2>
          <span class="sr-only" data-result-status role="status" aria-live="polite" aria-atomic="true">
            {products.length} alloy-grade pages shown
          </span>
        </div>
        <p>Each grade page owns supplier, process, PSD, price, and document intent without creating thin duplicate URLs.</p>
      </div>

      <div class="catalog-grid" data-catalog-grid>
        {products.map((product, index) => <ProductCard product={product} index={index} />)}
      </div>

      <div class="catalog-empty" data-catalog-empty hidden>
        <strong>No exact powder product matches all filters.</strong>
        <p>Clear one filter or submit a custom powder RFQ with the target chemistry, PSD, quantity, and process.</p>
        <a class="button button--primary" href="/rfq/?custom=1">Start custom powder RFQ</a>
      </div>
    </section>

    <section class="extended-catalog page-shell" aria-labelledby="extended-catalog-title">
      <div class="section-heading">
        <p class="eyebrow">Extended sourcing matrix</p>
        <h2 id="extended-catalog-title">Additional alloy systems for specification-led sourcing.</h2>
        <p>
          The core cards above have dedicated technical routes. The extended matrix captures additional grade and
          process capabilities without creating thin product pages or implying current stock. Select a grade to open a
          prefilled custom RFQ.
        </p>
      </div>

      <div class="alloy-matrix">
        {extendedAlloyMatrix.map((group) => (
          <article>
            <div class="alloy-matrix__heading">
              <h3>{group.family}</h3>
              <span>{group.grades.length} designations</span>
            </div>
            <ul>
              {group.grades.map((grade) => (
                <li>
                  <a href={`/rfq/?custom=1&material=${encodeURIComponent(grade)}`}>{grade}</a>
                </li>
              ))}
            </ul>
            <dl>
              <div>
                <dt>Candidate routes</dt>
                <dd>{group.routes}</dd>
              </div>
              <div>
                <dt>RFQ focus</dt>
                <dd>{group.procurementFocus}</dd>
              </div>
            </dl>
          </article>
        ))}
      </div>

      <div class="section-heading section-heading--process">
        <p class="eyebrow">Process powder windows</p>
        <h2>Start with the process, then qualify the PSD.</h2>
        <p>
          These ranges are capability-screening candidates. The machine, feed system, test method, chemistry, and quoted
          lot determine the final usable specification.
        </p>
      </div>
      <div class="process-window-wrap">
        <table class="process-window-table">
          <thead>
            <tr>
              <th scope="col">Process</th>
              <th scope="col">Candidate PSD</th>
              <th scope="col">Material examples</th>
              <th scope="col">RFQ controls</th>
            </tr>
          </thead>
          <tbody>
            {processPowderWindows.map((window) => (
              <tr>
                <th scope="row">{window.process}</th>
                <td>{window.candidatePsd}</td>
                <td>{window.materialExamples}</td>
                <td>{window.rfqControl}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="extended-catalog__boundary">
        Matrix inclusion means the grade or route is suitable for source review. It does not confirm inventory,
        production capacity, certification scope, export eligibility, price, lead time, or lot documentation.
      </p>
    </section>

    <section class="catalog-help page-shell">
      <div>
        <p class="eyebrow">Cannot find the exact grade?</p>
        <h2>Use the catalog as a specification starting point.</h2>
        <p>
          Non-standard chemistry, tighter interstitial limits, uncommon PSD, special packaging, and qualification
          programs require a technical review. Add the nearest material—or leave the grade open—and describe the
          project requirement.
        </p>
      </div>
      <a class="button button--primary" href="/rfq/?custom=1">Request a custom powder</a>
    </section>
  </main>

  <SiteFooter />

  <script is:inline>
    (() => {
      const panel = document.querySelector('[data-catalog-filters]');
      const cards = Array.from(document.querySelectorAll('[data-product-card]'));
      if (!panel || !cards.length) return;

      const search = panel.querySelector('[data-filter-search]');
      const family = panel.querySelector('[data-filter-family]');
      const process = panel.querySelector('[data-filter-process]');
      const application = panel.querySelector('[data-filter-application]');
      const count = document.querySelector('[data-result-count]');
      const status = document.querySelector('[data-result-status]');
      const empty = document.querySelector('[data-catalog-empty]');
      const reset = panel.querySelector('[data-filter-reset]');

      const params = new URLSearchParams(window.location.search);
      if (family) family.value = params.get('family') || '';
      if (process) process.value = params.get('process') || '';
      if (application) application.value = params.get('application') || '';
      if (search) search.value = params.get('q') || '';

      const apply = () => {
        const query = search?.value.trim().toLowerCase() || '';
        const selectedFamily = family?.value || '';
        const selectedProcess = process?.value || '';
        const selectedApplication = application?.value || '';
        let visible = 0;

        cards.forEach((card) => {
          const matches =
            (!query || card.dataset.search?.includes(query)) &&
            (!selectedFamily || card.dataset.family === selectedFamily) &&
            (!selectedProcess || card.dataset.processes?.split('|').includes(selectedProcess)) &&
            (!selectedApplication || card.dataset.applications?.split('|').includes(selectedApplication));

          card.hidden = !matches;
          if (matches) visible += 1;
        });

        if (count) count.textContent = String(visible);
        if (status) status.textContent = `${visible} alloy-grade page${visible === 1 ? '' : 's'} shown`;
        if (empty) empty.hidden = visible !== 0;

        const next = new URLSearchParams();
        if (query) next.set('q', query);
        if (selectedFamily) next.set('family', selectedFamily);
        if (selectedProcess) next.set('process', selectedProcess);
        if (selectedApplication) next.set('application', selectedApplication);
        window.history.replaceState({}, '', `${window.location.pathname}${next.size ? `?${next}` : ''}`);
      };

      [search, family, process, application].forEach((control) => {
        control?.addEventListener(control === search ? 'input' : 'change', apply);
      });

      reset?.addEventListener('click', () => {
        if (search) search.value = '';
        if (family) family.value = '';
        if (process) process.value = '';
        if (application) application.value = '';
        apply();
      });

      apply();
    })();
  </script>
</BaseLayout>

<style>
  .catalog-page {
    gap: 0;
  }

  .catalog-hero {
    color: #fff;
    background:
      radial-gradient(circle at 90% 20%, rgba(71, 145, 211, 0.28), transparent 26rem),
      linear-gradient(130deg, #091f36, #0b3157);
  }

  .catalog-hero .eyebrow {
    color: #9ec4e1;
  }

  .catalog-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.65fr);
    gap: 3rem;
    align-items: end;
    padding-block: clamp(3rem, 5.5vw, 5rem);
  }

  .catalog-hero__inner > div {
    display: grid;
    gap: 0.9rem;
  }

  .catalog-hero h1 {
    max-width: 48rem;
    margin: 0;
    color: #fff;
    font-size: clamp(2.4rem, 4.6vw, 3.75rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .catalog-hero p:last-child {
    max-width: 46rem;
    margin: 0;
    color: #c0cedb;
    line-height: 1.72;
  }

  .catalog-hero aside {
    display: grid;
    gap: 0.4rem;
    padding: 1.15rem 1.25rem;
    border-left: 3px solid var(--accent);
    background: rgba(255, 255, 255, 0.06);
  }

  .catalog-hero aside strong {
    color: #fff;
    font-size: 1.1rem;
  }

  .catalog-hero aside > span {
    color: #a9bdce;
    font-size: 0.8rem;
  }

  .catalog-hero aside a {
    margin-top: 0.4rem;
    color: #fff;
    font-size: 0.82rem;
    font-weight: 740;
  }

  .catalog-hero aside a span {
    display: inline-flex;
    min-width: 1.3rem;
    height: 1.3rem;
    align-items: center;
    justify-content: center;
    margin-inline: 0.18rem;
    border-radius: 50%;
    color: var(--brand-dark);
    background: #fff;
    font-size: 0.68rem;
  }

  .catalog-shell {
    display: grid;
    gap: 2rem;
    padding-block: 2.5rem 4.5rem;
  }

  .filter-panel {
    display: grid;
    gap: 1rem;
    margin-top: -4.4rem;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow: 0 18px 50px rgba(9, 31, 54, 0.14);
  }

  .filter-panel__top {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }

  .filter-panel__top h2 {
    margin: 0.25rem 0 0;
    font-size: 1.2rem;
    letter-spacing: -0.024em;
  }

  .filter-panel__top button {
    padding: 0.45rem 0;
    border: 0;
    color: var(--brand);
    background: transparent;
    font-size: 0.78rem;
    font-weight: 720;
  }

  .filter-grid {
    display: grid;
    grid-template-columns: minmax(18rem, 1.5fr) repeat(3, minmax(10rem, 0.7fr));
    gap: 0.7rem;
  }

  .filter-grid label {
    display: grid;
    gap: 0.38rem;
  }

  .filter-grid label > span {
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .filter-grid input,
  .filter-grid select {
    width: 100%;
    min-height: 3rem;
    padding: 0.72rem 0.8rem;
    border: 1px solid var(--line-strong);
    border-radius: 0.52rem;
    color: var(--text);
    background: var(--surface);
    font-size: 0.84rem;
  }

  .catalog-results__head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    padding-top: 0.4rem;
  }

  .catalog-results__head h2 {
    margin: 0.22rem 0 0;
    font-size: 1.7rem;
    letter-spacing: -0.03em;
  }

  .catalog-results__head > p {
    max-width: 33rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.55;
    text-align: right;
  }

  .catalog-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .catalog-grid > [hidden] {
    display: none;
  }

  .catalog-empty {
    justify-items: center;
    gap: 0.65rem;
    padding: 3rem 1.5rem;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-card);
    text-align: center;
    background: var(--surface);
  }

  .catalog-empty:not([hidden]) {
    display: grid;
  }

  .catalog-empty strong {
    font-size: 1.2rem;
  }

  .catalog-empty p {
    max-width: 40rem;
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
  }

  .catalog-help {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem;
    align-items: center;
    margin-bottom: 1rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--brand-soft);
  }

  .extended-catalog {
    display: grid;
    gap: 1.5rem;
    padding-block: 0 4.5rem;
  }

  .extended-catalog > .section-heading {
    max-width: 58rem;
  }

  .extended-catalog .section-heading h2 {
    margin: 0.25rem 0 0.7rem;
    font-size: clamp(1.65rem, 3vw, 2.35rem);
    letter-spacing: -0.035em;
  }

  .extended-catalog .section-heading > p:last-child {
    margin: 0;
    color: var(--muted);
    line-height: 1.65;
  }

  .alloy-matrix {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .alloy-matrix > article {
    display: grid;
    gap: 1rem;
    padding: 1.2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }

  .alloy-matrix__heading {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
  }

  .alloy-matrix__heading h3 {
    margin: 0;
    font-size: 1.15rem;
    letter-spacing: -0.025em;
  }

  .alloy-matrix__heading span {
    color: var(--muted);
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .alloy-matrix ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.42rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .alloy-matrix li a {
    display: inline-flex;
    padding: 0.36rem 0.58rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--text);
    background: var(--surface-soft);
    font-size: 0.78rem;
    font-weight: 650;
  }

  .alloy-matrix dl {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding-top: 0.8rem;
    border-top: 1px solid var(--line);
  }

  .alloy-matrix dl div {
    display: grid;
    grid-template-columns: 7.4rem minmax(0, 1fr);
    gap: 0.75rem;
  }

  .alloy-matrix dt {
    color: var(--muted);
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .alloy-matrix dd {
    margin: 0;
    color: var(--copy);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .section-heading--process {
    margin-top: 1.25rem;
  }

  .process-window-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
  }

  .process-window-table {
    width: 100%;
    min-width: 62rem;
    border-collapse: collapse;
  }

  .process-window-table th,
  .process-window-table td {
    padding: 0.9rem;
    border-bottom: 1px solid var(--line);
    color: var(--copy);
    font-size: 0.8rem;
    line-height: 1.55;
    text-align: left;
    vertical-align: top;
  }

  .process-window-table thead th {
    color: var(--muted);
    background: var(--surface-soft);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .process-window-table tbody th {
    color: var(--text);
    font-weight: 760;
  }

  .process-window-table tbody tr:last-child th,
  .process-window-table tbody tr:last-child td {
    border-bottom: 0;
  }

  .extended-catalog__boundary {
    margin: 0;
    padding: 0.9rem 1rem;
    border-left: 3px solid var(--accent);
    color: var(--muted);
    background: var(--brand-soft);
    font-size: 0.8rem;
    line-height: 1.55;
  }

  .catalog-help > div {
    display: grid;
    gap: 0.55rem;
  }

  .catalog-help h2 {
    margin: 0;
    font-size: clamp(1.45rem, 2.4vw, 2rem);
    letter-spacing: -0.03em;
  }

  .catalog-help p:last-child {
    max-width: 53rem;
    margin: 0;
    color: var(--copy);
    line-height: 1.65;
  }

  @media (max-width: 1080px) {
    .filter-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .catalog-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .catalog-hero__inner,
    .catalog-help {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .catalog-hero aside {
      max-width: 25rem;
    }

    .catalog-results__head {
      display: grid;
      align-items: start;
    }

    .catalog-results__head > p {
      text-align: left;
    }

    .alloy-matrix {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 580px) {
    .filter-panel {
      margin-top: -2rem;
    }

    .filter-panel__top {
      align-items: start;
    }

    .filter-grid,
    .catalog-grid {
      grid-template-columns: 1fr;
    }

    .catalog-help .button {
      width: 100%;
    }

    .alloy-matrix dl div {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>
