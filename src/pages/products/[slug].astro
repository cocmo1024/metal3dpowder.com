---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductCard from '../../components/ProductCard.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { getPowderScreeningWindow } from '../../data/powderCapabilities';
import { buildBreadcrumbSchema, defaultOgImagePath } from '../../data/seo';
import { getProductPath, products, type Product } from '../../data/products';
import { getProductSearchIntent } from '../../data/searchIntent';

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const siteUrl = Astro.site ?? new URL('https://metal3dpowder.com');
const productPath = getProductPath(product);
const screeningWindow = getPowderScreeningWindow(product.id);
const searchIntent = getProductSearchIntent(product.id);
const title = searchIntent.seoTitle;
const description = searchIntent.metaDescription;
const relatedProducts = products
  .filter((candidate) => candidate.id !== product.id)
  .sort((left, right) => Number(right.family === product.family) - Number(left.family === product.family))
  .slice(0, 3);
const breadcrumbItems = [
  { name: 'Home', path: '/' },
  { name: 'Powder catalog', path: '/products/' },
  { name: product.name },
];

const schema = [
  buildBreadcrumbSchema(siteUrl, breadcrumbItems),
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    '@id': `${new URL(productPath, siteUrl).toString()}#product`,
    name: searchIntent.primaryQuery,
    alternateName: product.schemaAliases,
    category: product.familyLabel,
    description: product.summary,
    image: new URL(product.image, siteUrl).toString(),
    url: new URL(productPath, siteUrl).toString(),
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': `${new URL(productPath, siteUrl).toString()}#webpage`,
    },
    additionalProperty: [
      {
        '@type': 'PropertyValue',
        name: 'Primary procurement query',
        value: searchIntent.primaryQuery,
      },
      {
        '@type': 'PropertyValue',
        name: 'Common procurement search designations',
        value: product.aliases.join(', '),
      },
      {
        '@type': 'PropertyValue',
        name: 'Candidate particle-size routes',
        value: product.particleSizes.join(', '),
      },
      {
        '@type': 'PropertyValue',
        name: 'Candidate manufacturing processes',
        value: product.processes.join(', '),
      },
      {
        '@type': 'PropertyValue',
        name: 'Supply status',
        value: product.availabilityLabel,
      },
      ...(screeningWindow
        ? screeningWindow.metrics.map((metric) => ({
            '@type': 'PropertyValue',
            name: `Indicative screening value: ${metric.label}`,
            value: metric.value,
            description: [screeningWindow.route, screeningWindow.basis, metric.qualification].filter(Boolean).join(' '),
          }))
        : []),
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={productPath}
  ogImage={defaultOgImagePath}
  ogImageAlt="Metal powder catalog and specification-led RFQ"
  schema={schema}
>
  <SiteHeader pathname={Astro.url.pathname} />

  <main
    id="main-content"
    class="product-page"
    style={`--product-accent:${product.accent};`}
    data-intent-layer="alloy-grade-commercial"
    data-search-owner={searchIntent.primaryQuery}
  >
    <Breadcrumbs items={breadcrumbItems} contained />

    <section class="product-hero page-shell">
      <div class="product-gallery">
        <div class="product-gallery__main">
          <img
            src={product.image}
            alt={`${product.name} powder product illustration`}
            width="800"
            height="560"
            decoding="async"
            fetchpriority="high"
          />
          <span>Illustrative powder image</span>
        </div>
        <div class="product-gallery__evidence">
          <article>
            <span>01</span>
            <div>
              <strong>Lot documentation</strong>
              <small>COA and PSD data available subject to the quoted lot</small>
            </div>
          </article>
          <article>
            <span>02</span>
            <div>
              <strong>Process fit</strong>
              <small>Matched to equipment and build requirement</small>
            </div>
          </article>
        </div>
      </div>

      <div class="product-summary">
        <div class="product-summary__topline">
          <span>{product.familyLabel}</span>
          <span>{product.availabilityLabel}</span>
        </div>
        <p class="product-code">{product.code}</p>
        <h1>{searchIntent.primaryQuery} supplier and RFQ</h1>
        <p class="product-deck">{product.summary}</p>

        <div class="alias-row" aria-label="Alternate designations">
          <strong>Also searched as</strong>
          <ul>
            {product.aliases.map((alias) => <li>{alias}</li>)}
          </ul>
        </div>

        <dl class="quick-specs">
          <div>
            <dt>PSD candidates</dt>
            <dd>{product.particleSizes.join(' · ')}</dd>
          </div>
          <div>
            <dt>Process routes</dt>
            <dd>{product.processes.join(' · ')}</dd>
          </div>
          <div>
            <dt>Commercial path</dt>
            <dd>{product.orderLabel}</dd>
          </div>
        </dl>

        <div class="product-actions">
          <a class="button button--primary" href={`/rfq/?product=${product.id}`}>Request this powder</a>
          <button
            type="button"
            class="button button--ghost"
            data-add-product={product.id}
            data-product-name={product.name}
          >
            Add to RFQ
          </button>
        </div>
        <p class="product-boundary">
          Final price, availability, lead time, chemistry, performance data, and documentation are confirmed for the
          quoted specification and lot.
        </p>
      </div>
    </section>

    <section class="decision-strip">
      <div class="page-shell decision-strip__inner">
        <article>
          <span>Application</span>
          <strong>{product.bestFor[0]}</strong>
        </article>
        <article>
          <span>Process</span>
          <strong>{product.processes[0]} or project-defined route</strong>
        </article>
        <article>
          <span>Documentation</span>
          <strong>Specification + lot documents</strong>
        </article>
      </div>
    </section>

    <nav class="intent-jump page-shell" aria-label={`${searchIntent.primaryQuery} purchasing sections`}>
      <span>On this grade page</span>
      <a href="#grade-designations">Designations & search names</a>
      <a href="#process-and-particle-size">Process & particle size</a>
      <a href="#standards-and-documents">Standards & documents</a>
      <a href="#price-and-quote-inputs">Price & quote inputs</a>
    </nav>

    <section class="product-content page-shell">
      <div class="product-content__main">
        <section id="grade-designations" class="content-block" aria-labelledby="grade-designations-title">
          <div class="section-heading">
            <p class="eyebrow">Grade search intent</p>
            <h2 id="grade-designations-title">Specify this powder by grade, then narrow the buying requirement.</h2>
            <p>{searchIntent.designationGuidance}</p>
          </div>
          <div class="buyer-query-grid" aria-label={`Common procurement searches for ${searchIntent.primaryQuery}`}>
            {searchIntent.buyerQueries.map((query) => (
              <article data-buyer-query>
                <span>Procurement query</span>
                <strong>{query}</strong>
              </article>
            ))}
          </div>
          <p class="search-boundary">
            These search patterns are consolidated on this grade owner page. They describe buying intent—not separate
            stock items, guaranteed specifications, fixed prices, or additional thin landing pages.
          </p>
        </section>

        <section class="content-block" aria-labelledby="fit-title">
          <div class="section-heading">
            <p class="eyebrow">Application fit</p>
            <h2 id="fit-title">Applications suited to technical review.</h2>
          </div>
          <div class="fit-grid">
            {product.bestFor.map((item, index) => (
              <article>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <p>{item}</p>
              </article>
            ))}
          </div>
          <ul class="tag-list" aria-label="Application markets">
            {product.applications.map((application) => <li>{application}</li>)}
          </ul>
        </section>

        <section class="content-block" aria-labelledby="specification-title">
          <div class="section-heading">
            <p class="eyebrow">Specification controls</p>
            <h2 id="specification-title">Define the powder beyond the alloy designation.</h2>
            <p>
              The same grade name can represent materially different powder routes. A usable RFQ needs the acceptance
              method, limits, packaging, and intended process.
            </p>
          </div>
          <div class="control-grid">
            <article>
              <span>01</span>
              <h3>Chemistry & standard</h3>
              <p>State the governing grade, revision, restricted elements, and any tighter oxygen or nitrogen limits.</p>
            </article>
            <article>
              <span>02</span>
              <h3>PSD & method</h3>
              <p>Choose a candidate range and state whether sieve, laser diffraction, or a customer method controls acceptance.</p>
            </article>
            <article>
              <span>03</span>
              <h3>Powder behavior</h3>
              <p>Define required flow, apparent/tap density, morphology evidence, satellites, and hollow-particle limits where relevant.</p>
            </article>
            <article>
              <span>04</span>
              <h3>Lot & reuse plan</h3>
              <p>Confirm lot size, virgin/reused powder policy, blend restrictions, sampling, retention, and traceability expectations.</p>
            </article>
          </div>
        </section>

        <section id="process-and-particle-size" class="content-block" aria-labelledby="route-title">
          <div class="section-heading">
            <p class="eyebrow">Process and PSD</p>
            <h2 id="route-title">Process and PSD options to confirm in the RFQ.</h2>
            <p>
              PSD labels below are catalog starting points. Final fit depends on the machine, layer strategy, feed system,
              qualification plan, and the supplier lot.
            </p>
          </div>
          <div class="route-table-wrap">
            <table class="route-table">
              <thead>
                <tr>
                  <th scope="col">Decision variable</th>
                  <th scope="col">Catalog starting points</th>
                  <th scope="col">Required confirmation</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <th scope="row">Process candidates</th>
                  <td>{product.processes.join(' · ')}</td>
                  <td>Machine, feed system, layer strategy, and qualification stage</td>
                </tr>
                <tr>
                  <th scope="row">PSD candidates</th>
                  <td>{product.particleSizes.join(' · ')}</td>
                  <td>Target process, equipment limits, and PSD test method</td>
                </tr>
                <tr>
                  <th scope="row">Process × PSD pairing</th>
                  <td>Not implied by this catalog page</td>
                  <td>Confirmed in the RFQ against the selected source and lot</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        {
          screeningWindow && (
            <section class="content-block" aria-labelledby="screening-window-title">
              <div class="section-heading">
                <p class="eyebrow">Powder screening data</p>
                <h2 id="screening-window-title">A screening window for a better technical RFQ.</h2>
                <p>
                  These grade-specific values help define the questions to ask. They are not stock data, a universal
                  specification, or a lot certificate.
                </p>
              </div>
              <div class="route-table-wrap">
                <table class="route-table">
                  <thead>
                    <tr>
                      <th scope="col">Powder metric</th>
                      <th scope="col">Screening value</th>
                      <th scope="col">Qualification boundary</th>
                    </tr>
                  </thead>
                  <tbody>
                    {screeningWindow.metrics.map((metric) => (
                      <tr>
                        <th scope="row">{metric.label}</th>
                        <td>{metric.value}</td>
                        <td>{metric.qualification ?? 'Method and lot to be confirmed'}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <p class="evidence-note">
                <strong>{screeningWindow.route}.</strong> {screeningWindow.basis} Ask for the governing test method,
                sampling rule, source, production route, and lot-linked report in the quotation.
              </p>
            </section>
          )
        }

        <section class="content-block content-block--split" aria-labelledby="risk-title">
          <div>
            <div class="section-heading">
              <p class="eyebrow">Failure modes</p>
              <h2 id="risk-title">Critical variables to verify before qualification.</h2>
            </div>
            <ul class="watch-list">
              {product.watchItems.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <aside>
            <strong>Qualification boundary</strong>
            <p>
              Powder conformity does not qualify the finished part. Printing, heat treatment, HIP, machining, inspection,
              service environment, and regulatory release remain separate responsibilities.
            </p>
          </aside>
        </section>

        <section id="standards-and-documents" class="content-block" aria-labelledby="documents-title">
          <div class="section-heading">
            <p class="eyebrow">Evidence package</p>
            <h2 id="documents-title">Request the documents that support the actual buying decision.</h2>
            <p>{searchIntent.specificationPrompt}</p>
          </div>
          <div class="document-grid">
            {product.documentOptions.map((document, index) => (
              <article>
                <span>DOC {String(index + 1).padStart(2, '0')}</span>
                <strong>{document}</strong>
                <small>Availability and scope confirmed in quotation</small>
              </article>
            ))}
          </div>
          <p class="evidence-note">
            Certificates, technical data, sample reports, and partner-specific documents are supplied only when they
            correspond to the quoted source, grade, particle-size route, and lot.
          </p>
        </section>

        <section id="price-and-quote-inputs" class="content-block" aria-labelledby="quote-inputs-title">
          <div class="section-heading">
            <p class="eyebrow">Price and supplier RFQ</p>
            <h2 id="quote-inputs-title">Price and availability follow the exact grade, PSD, evidence, and delivery scope.</h2>
            <p>
              A useful supplier comparison keeps the technical and commercial basis identical. Send the same inputs to
              avoid comparing different chemistry limits, powder routes, packages, or document scopes as if they were
              the same product.
            </p>
          </div>
          <div class="control-grid">
            <article>
              <span>01</span>
              <h3>Grade and acceptance basis</h3>
              <p>{searchIntent.specificationPrompt}</p>
            </article>
            <article>
              <span>02</span>
              <h3>Process, machine, and PSD</h3>
              <p>State the target process, equipment constraints, particle-size range, and governing PSD method.</p>
            </article>
            <article>
              <span>03</span>
              <h3>Quantity, packaging, and destination</h3>
              <p>Separate sample and production quantities; include package size, destination country, and target timing.</p>
            </article>
            <article>
              <span>04</span>
              <h3>Lot evidence and source controls</h3>
              <p>List required COA, PSD, SDS, TDS, SEM, traceability, sampling, and production-route evidence.</p>
            </article>
          </div>
          <a class="button button--primary quote-inputs-action" href={`/rfq/?product=${product.id}`}>
            Request {searchIntent.primaryQuery}
          </a>
        </section>
      </div>

      <aside class="product-content__aside" aria-label="Request summary">
        <div class="rfq-panel">
          <p class="eyebrow">Request a quotation</p>
          <h2>{product.name}</h2>
          <ol>
            <li>Choose process and candidate PSD</li>
            <li>Add quantity and destination</li>
            <li>State the applicable specification and acceptance criteria</li>
            <li>Receive a lot-specific commercial response</li>
          </ol>
          <a class="button button--primary" href={`/rfq/?product=${product.id}`}>Start structured RFQ</a>
          <button
            type="button"
            class="text-action"
            data-add-product={product.id}
            data-product-name={product.name}
          >
            Add to multi-product RFQ
          </button>
        </div>

        <div class="knowledge-panel">
          <span>Engineering background</span>
          <strong>Need material-selection context first?</strong>
          <p>Read the related technical guide, then return with the process, PSD, quantity, and acceptance needs.</p>
          <a href={product.knowledgePath}>Read the alloy guide →</a>
        </div>
      </aside>
    </section>

    <section class="related-section page-shell" aria-labelledby="related-title">
      <div class="section-heading">
        <p class="eyebrow">Related routes</p>
        <h2 id="related-title">Compare adjacent powder options.</h2>
      </div>
      <div class="related-grid">
        {relatedProducts.map((related, index) => <ProductCard product={related} index={index} />)}
      </div>
    </section>

    <section class="product-final page-shell">
      <div>
        <p class="eyebrow">Custom chemistry or PSD?</p>
        <h2>Tell us the target chemistry, process, PSD, and acceptance criteria.</h2>
      </div>
      <a class="button button--primary" href="/rfq/?custom=1">Request a custom powder</a>
    </section>

    <div class="mobile-rfq-bar">
      <div>
        <span>{product.code}</span>
        <strong>{product.orderLabel}</strong>
      </div>
      <a href={`/rfq/?product=${product.id}`}>Request quote</a>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .product-page {
    gap: 0;
    padding-bottom: 2rem;
  }

  .product-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(24rem, 0.98fr);
    gap: clamp(2rem, 5vw, 4.75rem);
    align-items: center;
    padding-block: 1rem clamp(3.5rem, 7vw, 6.5rem);
  }

  .product-gallery {
    display: grid;
    gap: 0.8rem;
  }

  .product-gallery__main {
    position: relative;
    overflow: hidden;
    min-height: 27rem;
    border-radius: var(--radius-card);
    background: #0b1219;
    box-shadow: var(--shadow-card-hover);
  }

  .product-gallery__main::after {
    position: absolute;
    inset: 0;
    content: '';
    pointer-events: none;
    background:
      linear-gradient(180deg, transparent 67%, rgba(3, 9, 14, 0.55)),
      radial-gradient(circle at 82% 18%, color-mix(in srgb, var(--product-accent) 34%, transparent), transparent 30%);
  }

  .product-gallery__main img {
    width: 100%;
    height: 100%;
    min-height: 27rem;
    object-fit: cover;
  }

  .product-gallery__main > span {
    position: absolute;
    z-index: 1;
    bottom: 1rem;
    left: 1rem;
    padding: 0.38rem 0.55rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    color: #fff;
    background: rgba(5, 14, 21, 0.58);
    font-size: 0.82rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    backdrop-filter: blur(10px);
  }

  .product-gallery__evidence {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .product-gallery__evidence article {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.8rem;
    align-items: start;
    padding: 0.9rem;
    border: 1px solid var(--line);
    border-radius: 0.7rem;
    background: var(--surface);
  }

  .product-gallery__evidence article > span {
    color: var(--brand);
    font-size: 0.82rem;
    font-weight: 800;
  }

  .product-gallery__evidence div {
    display: grid;
    gap: 0.2rem;
  }

  .product-gallery__evidence strong {
    font-size: 0.9rem;
  }

  .product-gallery__evidence small {
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .product-summary {
    display: grid;
    gap: 1rem;
  }

  .product-summary__topline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .product-summary__topline span {
    padding: 0.42rem 0.68rem;
    border-radius: 999px;
    color: var(--brand);
    background: var(--brand-soft);
    font-size: 0.82rem;
    font-weight: 750;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  .product-summary__topline span:last-child {
    color: var(--success-text);
    background: var(--success-bg);
  }

  .product-code {
    margin: 0.35rem 0 -0.45rem;
    color: var(--brand);
    font-size: 0.88rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .product-summary h1 {
    max-width: 37rem;
    margin: 0;
    color: var(--text);
    font-size: clamp(2.4rem, 4.6vw, 3.75rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .product-deck {
    max-width: 38rem;
    margin: 0;
    color: var(--copy);
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .alias-row {
    display: grid;
    gap: 0.52rem;
    padding-block: 0.9rem;
    border-block: 1px solid var(--line);
  }

  .alias-row strong {
    color: var(--muted);
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .alias-row ul,
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.42rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .alias-row li,
  .tag-list li {
    padding: 0.38rem 0.62rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--text);
    background: var(--surface-soft);
    font-size: 0.82rem;
  }

  .quick-specs {
    display: grid;
    gap: 0;
    margin: 0;
  }

  .quick-specs div {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--line);
  }

  .quick-specs dt {
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .quick-specs dd {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 660;
  }

  .product-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    padding-top: 0.35rem;
  }

  .product-boundary {
    margin: 0;
    padding-left: 0.8rem;
    border-left: 2px solid var(--product-accent);
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .decision-strip {
    color: #fff;
    background:
      radial-gradient(circle at 82% 0%, color-mix(in srgb, var(--product-accent) 22%, transparent), transparent 28rem),
      var(--brand-dark);
  }

  .decision-strip__inner {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
  }

  .decision-strip article {
    display: grid;
    gap: 0.42rem;
    padding: 1.35rem 1.4rem;
    border-left: 1px solid rgba(255, 255, 255, 0.12);
  }

  .decision-strip article:last-child {
    border-right: 1px solid rgba(255, 255, 255, 0.12);
  }

  .decision-strip span {
    color: #91a9bd;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .decision-strip strong {
    font-size: 0.94rem;
    line-height: 1.4;
  }

  .intent-jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 0.9rem;
    align-items: center;
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .intent-jump span {
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .intent-jump a {
    color: var(--brand);
    font-size: 0.86rem;
    font-weight: 700;
  }

