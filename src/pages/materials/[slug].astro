---
import { getCollection } from 'astro:content';
import ContentHub from '../../components/ContentHub.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBlogPostPath, sortBlogPosts, type BlogPost } from '../../data/blog';
import { materialHubs, type HubDefinition } from '../../data/contentHubs';
import { getProductsForHub } from '../../data/productRoutes';
import { getProductPath } from '../../data/products';
import { buildBreadcrumbSchema, buildCollectionPageSchema } from '../../data/seo';

interface Props {
  hub: HubDefinition;
}

export function getStaticPaths() {
  return materialHubs.map((hub) => ({
    params: { slug: hub.slug },
    props: { hub },
  }));
}

const { hub } = Astro.props;
const allPosts = sortBlogPosts(await getCollection('blog'));
const postMap = new Map(allPosts.map((post) => [post.id, post]));
const posts = hub.postIds.map((id) => postMap.get(id)).filter((post): post is BlogPost => Boolean(post));
const relatedProducts = getProductsForHub(hub);
const canonical = `/materials/${hub.slug}/`;
const seoTitle = `${hub.title} for AM | Alloy Grade Guide`;
const pageHeading = `${hub.title} for Additive Manufacturing`;
const metaDescription = `Compare ${hub.title.toLowerCase()} grades, international designations, AM process fit, particle-size routes, evidence requirements, and supplier RFQ inputs.`;
const siteUrl = Astro.site ?? new URL('https://metal3dpowder.com');
const breadcrumbItems = [
  { name: 'Home', path: '/' },
  { name: 'Materials', path: '/materials/' },
  { name: hub.title },
];
const schema = [
  buildCollectionPageSchema({
    site: siteUrl,
    path: canonical,
    name: pageHeading,
    description: metaDescription,
    items: [
      ...relatedProducts.map((product) => ({ name: product.name, path: getProductPath(product) })),
      ...posts.map((post) => ({ name: post.data.title, path: getBlogPostPath(post) })),
    ],
  }),
  buildBreadcrumbSchema(siteUrl, breadcrumbItems),
];
---

<BaseLayout title={seoTitle} description={metaDescription} canonical={canonical} schema={schema}>
  <SiteHeader pathname={Astro.url.pathname} />
  <ContentHub
    breadcrumbItems={breadcrumbItems}
    eyebrow="Material family"
    title={pageHeading}
    description={hub.description}
    products={relatedProducts}
    productsTitle={`${hub.title} grades for specification-led RFQ`}
    posts={posts}
    postsTitle={`Technical guides supporting ${hub.title.toLowerCase()} selection`}
    intentLayer="material-family"
  />
  <SiteFooter />
</BaseLayout>
