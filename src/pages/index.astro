---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogPostGrid from '../components/BlogPostGrid.astro';
import ProductCard from '../components/ProductCard.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { buildCollectionPageSchema, buildOrganizationSchema } from '../data/seo';
import { siteInfo } from '../data/site';
import {
  getProductPath,
  productFamilies,
  productProcesses,
  products,
} from '../data/products';
import { getBlogPostPath, sortBlogPosts } from '../data/blog';
import { applicationHubs, getHubPath } from '../data/contentHubs';

const title = 'Metal Powder Supplier for AM, MIM & Binder Jet | Metal 3D Powder';
const description =
  'Browse titanium, stainless, nickel, aluminum, copper, tool steel, and cobalt chrome powders by alloy, process, PSD, and application. Build a lot-specific RFQ online.';

const siteUrl = Astro.site ?? new URL('https://metal3dpowder.com');
const allPosts = sortBlogPosts(await getCollection('blog'));
const latestPosts = allPosts.slice(0, 3);
const featuredProducts = products.filter((product) => product.featured).slice(0, 6);
const applicationSlugs = [
  'aerospace-space',
  'medical-implants',
  'ai-liquid-cooling',
  'tooling-and-mold-inserts',
  'energy-and-propulsion',
  'industrial-automation-robotics',
];
const featuredApplications = applicationSlugs
  .map((slug) => applicationHubs.find((hub) => hub.slug === slug))
  .filter((hub): hub is (typeof applicationHubs)[number] => Boolean(hub));

const processCards = [
  {
    label: 'LPBF',
    title: 'Laser powder bed fusion',
    description: 'Fine spherical powder routes for dense, detailed, and qualification-led builds.',
    href: '/processes/lpbf/',
    index: '01',
  },
  {
    label: 'EBM',
    title: 'Electron beam melting',
    description: 'Titanium and high-temperature powder routes with process-specific PSD requirements.',
    href: '/products/?process=EBM',
    index: '02',
  },
  {
    label: 'DED',
    title: 'Directed energy deposition',
    description: 'Coarser feedstock routes for repair, cladding, larger structures, and material addition.',
    href: '/processes/ded/',
    index: '03',
  },
  {
    label: 'MIM / Binder jet',
    title: 'Sinter-based production',
    description: 'Fine powder routes where flow, packing, debinding, and shrinkage control the result.',
    href: '/processes/binder-jet/',
    index: '04',
  },
];

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteInfo.brand,
  alternateName: 'Metal3DPowder',
  url: siteUrl.toString(),
};

const collectionPageSchema = buildCollectionPageSchema({
  site: siteUrl,
  path: '/',
  name: 'Metal powder product catalog and sourcing portal',
  description,
  items: [
    ...products.map((product) => ({
      name: `${product.name} powder`,
      path: getProductPath(product),
    })),
    ...latestPosts.map((post) => ({
      name: post.data.title,
      path: getBlogPostPath(post),
    })),
  ],
});
---

<BaseLayout
  title={title}
  description={description}
  canonical="/"
  ogImageAlt="Metal powder product catalog"
  schema={[websiteSchema, buildOrganizationSchema(siteUrl), collectionPageSchema]}
>
  <SiteHeader pathname={Astro.url.pathname} />

  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__inner page-shell">
        <div class="hero__copy">
          <p class="hero__eyebrow">Industrial metal powder catalog</p>
          <h1 id="hero-title">Metal powder sourcing, built around your process.</h1>
          <p class="hero__lead">
            Find the alloy, particle-size route, and production evidence your program requires. Every formal quote
            confirms the producing route, lot documentation, packaging, availability, and destination requirements.
          </p>

          <div class="hero__actions">
            <a class="button button--hero" href="/products/">Browse powder catalog</a>
            <a class="button button--dark" href="/rfq/">Build a multi-product RFQ</a>
          </div>

          <ul class="hero__routes" aria-label="Supported powder process routes">
            {productProcesses.map((process) => <li>{process}</li>)}
          </ul>
        </div>

        <div class="hero-showcase" aria-label="Representative metal powder families">
          <div class="hero-showcase__grid" aria-hidden="true"></div>

          <a class="hero-product hero-product--primary" href="/products/ti64/">
            <img src="/images/products/titanium.svg" alt="" width="800" height="560" />
            <span>
              <small>Titanium route</small>
              <strong>Ti64 · LPBF / EBM</strong>
            </span>
          </a>

          <a class="hero-product hero-product--secondary" href="/products/in718/">
            <img src="/images/products/in718.svg" alt="" width="800" height="560" />
            <span>
              <small>Nickel route</small>
              <strong>IN718 · LPBF / DED</strong>
            </span>
          </a>

          <a class="hero-product hero-product--tertiary" href="/products/cucrzr/">
            <img src="/images/products/cucrzr.svg" alt="" width="800" height="560" />
            <span>
              <small>Conductive route</small>
              <strong>CuCrZr · LPBF</strong>
            </span>
          </a>

          <div class="hero-showcase__note">
            <span>RFQ READY</span>
            <p>Choose a grade now. Confirm producer, specification, and lot before order.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="proof-strip page-shell" aria-label="Catalog scope">
      <article>
        <strong>{products.length}</strong>
        <span>core powder routes</span>
      </article>
      <article>
        <strong>{productFamilies.length}</strong>
        <span>alloy families</span>
      </article>
      <article>
        <strong>{productProcesses.length}</strong>
        <span>process routes</span>
      </article>
      <article>
        <strong>Lot-specific</strong>
        <span>commercial confirmation</span>
      </article>
    </section>

    <section class="finder-section page-shell" aria-labelledby="finder-title">
      <div class="section-heading">
        <p class="eyebrow">Powder finder</p>
        <h2 id="finder-title">Start with the alloy family.</h2>
        <p>
          Search by common grade, international designation, process, or application. Product pages remain public and
          indexable; pricing, availability, and final specifications are confirmed in the RFQ.
        </p>
      </div>

      <div class="family-grid">
        {
          productFamilies.map((family) => {
            const count = products.filter((product) => product.family === family.id).length;
            return (
              <a class="family-card" href={`/products/?family=${family.id}`} style={`--family-accent:${family.accent}`}>
                <span class="family-card__orb" aria-hidden="true"></span>
                <div>
                  <small>{count} {count === 1 ? 'route' : 'routes'}</small>
                  <h3>{family.label}</h3>
                  <p>{family.description}</p>
                </div>
                <span class="family-card__arrow" aria-hidden="true">→</span>
              </a>
            );
          })
        }
      </div>
    </section>

    <section class="featured-section" aria-labelledby="featured-title">
      <div class="featured-section__inner page-shell">
        <div class="section-heading">
          <p class="eyebrow">Featured commercial routes</p>
          <h2 id="featured-title">Selected powder routes for commercial review.</h2>
          <p>
            Each card shows requestable PSD routes and the commercial status. Add more than one product to the RFQ
            list when comparing alloys, processes, or suppliers.
          </p>
        </div>

        <div class="products-grid">
          {featuredProducts.map((product, index) => <ProductCard product={product} index={index} />)}
        </div>

        <div class="featured-section__action">
          <a class="button button--ghost" href="/products/">View all {products.length} powder routes</a>
        </div>
      </div>
    </section>

    <section class="process-section page-shell" aria-labelledby="process-title">
      <div class="process-section__header">
        <div class="section-heading">
          <p class="eyebrow">Choose by process</p>
          <h2 id="process-title">The same alloy is not the same product across every process.</h2>
        </div>
        <p>
          PSD, morphology, interstitial limits, flow, packing, and reuse expectations change by manufacturing route.
          Start with the process, then confirm the lot-level specification.
        </p>
      </div>

      <div class="process-grid">
        {
          processCards.map((process) => (
            <a href={process.href}>
              <span class="process-card__index">{process.index}</span>
              <p>{process.label}</p>
              <h3>{process.title}</h3>
              <span>{process.description}</span>
              <strong>Explore route →</strong>
            </a>
          ))
        }
      </div>
    </section>

    <section class="network-section" aria-labelledby="network-title">
      <div class="network-section__inner page-shell">
        <div class="network-section__copy">
          <p class="eyebrow">Partner-backed manufacturing</p>
          <h2 id="network-title">A sourcing network, presented with the correct capability boundary.</h2>
          <p>
            Depending on alloy and specification, sourcing can be matched to VIGA, EIGA, PREP, plasma atomization, and
            downstream powder processing through authorized production partners. The producing entity, applicable
            quality evidence, and commercial terms are identified in the formal quotation.
          </p>

          <div class="partner-list" aria-label="Authorized partner capability network">
            <span>VILORY · 威拉里</span>
            <span>AVIMETAL · 中航迈特</span>
            <span>BLT · 铂力特</span>
          </div>

          <a class="button button--dark" href="/about/">How the supply model works</a>
        </div>

        <ol class="sourcing-steps">
          <li>
            <span>01</span>
            <div>
              <strong>Define the requirement</strong>
              <p>Grade, process, PSD, chemistry limits, quantity, destination, documents, and timing.</p>
            </div>
          </li>
          <li>
            <span>02</span>
            <div>
              <strong>Match production route and lot</strong>
              <p>Choose the producer and atomization route that fit the alloy and program risk.</p>
            </div>
          </li>
          <li>
            <span>03</span>
            <div>
              <strong>Confirm evidence</strong>
              <p>Align COA, PSD, chemistry, testing, packaging, traceability, and any sample plan.</p>
            </div>
          </li>
          <li>
            <span>04</span>
            <div>
              <strong>Issue the commercial quote</strong>
              <p>State the actual product, quantity, price basis, lead time, shipping scope, and validity.</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section class="application-section page-shell" aria-labelledby="application-title">
      <div class="section-heading">
        <p class="eyebrow">Application markets</p>
        <h2 id="application-title">Move from end-use hardware to the right powder route.</h2>
        <p>
          Application pages connect service conditions and manufacturing choices to the alloy families that belong in
          a serious RFQ.
        </p>
      </div>

      <div class="application-grid">
        {
          featuredApplications.map((hub, index) => (
            <a href={getHubPath(hub)}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{hub.title}</h3>
              <p>{hub.description}</p>
              <strong>Open application center →</strong>
            </a>
          ))
        }
      </div>
    </section>

    <section class="knowledge-section page-shell" aria-labelledby="knowledge-title">
      <div class="knowledge-section__header">
        <div class="section-heading">
          <p class="eyebrow">Engineering library</p>
          <h2 id="knowledge-title">Technical content that supports purchasing decisions.</h2>
        </div>
        <a href="/knowledge/">Explore engineering knowledge →</a>
      </div>
      <BlogPostGrid posts={latestPosts} ariaLabel="Latest metal powder engineering updates" headingLevel={3} />
    </section>

    <section class="final-cta page-shell" aria-labelledby="final-cta-title">
      <div>
        <p class="eyebrow">Online RFQ</p>
        <h2 id="final-cta-title">Compare grades or send one exact specification.</h2>
        <p>
          Add products to the RFQ list, then submit the process, PSD, quantity, destination, timing, and supporting
          files. Unknown fields can remain open for technical review.
        </p>
      </div>
      <div class="final-cta__actions">
        <a class="button button--hero" href="/rfq/">Open RFQ list <span data-rfq-count data-empty>0</span></a>
        <a class="button button--dark" href={`mailto:${siteInfo.email}`}>Email sales</a>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    color: #fff;
    background:
      radial-gradient(circle at 80% 20%, rgba(33, 113, 184, 0.34), transparent 26rem),
      radial-gradient(circle at 15% 120%, rgba(214, 102, 44, 0.18), transparent 30rem),
      linear-gradient(135deg, #081b2f 0%, #0b2c4e 57%, #0a223b 100%);
  }

  .hero::before {
    position: absolute;
    inset: 0;
    content: '';
    pointer-events: none;
    opacity: 0.16;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.16) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.16) 1px, transparent 1px);
    background-size: 88px 88px;
    mask-image: linear-gradient(90deg, transparent, #000 55%, #000);
  }

  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.94fr) minmax(31rem, 1.06fr);
    min-height: 38rem;
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    padding-block: clamp(4.5rem, 8vw, 7rem);
  }

  .hero__copy {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 1.25rem;
    max-width: 43rem;
  }

  .hero__eyebrow {
    margin: 0;
    color: #8fc9ff;
    font-size: 0.76rem;
    font-weight: 780;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .hero h1 {
    max-width: 42rem;
    margin: 0;
    color: #fff;
    font-size: clamp(2.8rem, 5.6vw, 5rem);
    font-weight: 780;
    line-height: 0.98;
    letter-spacing: -0.048em;
  }

  .hero__lead {
    max-width: 40rem;
    margin: 0;
    color: #c2d0dc;
    font-size: clamp(1rem, 1.3vw, 1.12rem);
    line-height: 1.72;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .button--hero {
    color: #fff;
    border-color: var(--accent);
    background: var(--accent);
    box-shadow: 0 10px 24px rgba(214, 102, 44, 0.2);
  }

  .button--hero:hover {
    border-color: #ba5220;
    background: #ba5220;
  }

  .hero__routes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.48rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .hero__routes li {
    padding: 0.35rem 0.58rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 0.4rem;
    color: #adbdcb;
    background: rgba(255, 255, 255, 0.045);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .hero-showcase {
    position: relative;
    min-height: 29rem;
    perspective: 1000px;
  }

  .hero-showcase__grid {
    position: absolute;
    inset: 2rem 0 0 4rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 50%;
    transform: rotateX(65deg) rotateZ(-9deg);
    background:
      repeating-radial-gradient(circle, transparent 0 2rem, rgba(116, 185, 248, 0.11) 2.06rem 2.12rem),
      repeating-linear-gradient(90deg, transparent 0 2.8rem, rgba(116, 185, 248, 0.09) 2.86rem 2.92rem);
  }

  .hero-product {
    position: absolute;
    display: grid;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 0.8rem;
    background: rgba(8, 20, 33, 0.76);
    box-shadow: 0 26px 70px rgba(0, 0, 0, 0.32);
    backdrop-filter: blur(12px);
    transition: transform 200ms ease, border-color 200ms ease;
  }

  .hero-product:hover {
    z-index: 5;
    border-color: rgba(255, 255, 255, 0.46);
    transform: translateY(-5px) rotate(0deg);
  }

  .hero-product img {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: cover;
  }

  .hero-product span {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: grid;
    gap: 0.16rem;
    padding: 0.72rem 0.8rem;
    background: linear-gradient(180deg, transparent, rgba(5, 13, 22, 0.95) 34%);
  }

  .hero-product small {
    color: #93a9bd;
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-product strong {
    color: #fff;
    font-size: 0.82rem;
  }

  .hero-product--primary {
    z-index: 3;
    top: 1.2rem;
    left: 3.8rem;
    width: min(60%, 22rem);
    aspect-ratio: 10 / 7;
    transform: rotate(-3deg);
  }

  .hero-product--secondary {
    z-index: 2;
    top: 8.8rem;
    right: 0.5rem;
    width: min(52%, 18.5rem);
    aspect-ratio: 10 / 7;
    transform: rotate(4deg);
  }

  .hero-product--tertiary {
    z-index: 4;
    bottom: 0;
    left: 0;
    width: min(46%, 16rem);
    aspect-ratio: 10 / 7;
    transform: rotate(2deg);
  }

  .hero-showcase__note {
    position: absolute;
    z-index: 6;
    right: 1rem;
    bottom: 0.9rem;
    display: grid;
    max-width: 15rem;
    gap: 0.38rem;
    padding: 0.9rem 1rem;
    border-left: 3px solid var(--accent);
    color: #fff;
    background: rgba(7, 22, 37, 0.9);
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.25);
  }

  .hero-showcase__note span {
    color: #82c5ff;
    font-size: 0.66rem;
    font-weight: 780;
    letter-spacing: 0.13em;
  }

  .hero-showcase__note p {
    margin: 0;
    color: #b9c9d7;
    font-size: 0.74rem;
    line-height: 1.5;
  }

  .proof-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: -2.2rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }

  .proof-strip article {
    display: grid;
    gap: 0.2rem;
    padding: 1.2rem 1.4rem;
    border-right: 1px solid var(--line);
  }

  .proof-strip article:last-child {
    border-right: 0;
  }

  .proof-strip strong {
    color: var(--brand-dark);
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    line-height: 1.1;
  }

  .proof-strip span {
    color: var(--muted);
    font-size: 0.78rem;
  }

  .finder-section,
  .application-section,
  .knowledge-section {
    display: grid;
    gap: 1.8rem;
  }

  .family-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .family-card {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    min-height: 11.5rem;
    gap: 0.9rem;
    align-items: start;
    padding: 1rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow: 0 4px 16px rgba(12, 39, 65, 0.04);
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .family-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--family-accent) 54%, var(--line));
    box-shadow: var(--shadow-card);
  }

  .family-card__orb {
    width: 1.9rem;
    height: 1.9rem;
    margin-top: 0.1rem;
    border-radius: 50%;
    background:
      radial-gradient(circle at 30% 24%, #fff, color-mix(in srgb, var(--family-accent) 90%, #fff) 30%, var(--family-accent) 62%, #172b3d);
    box-shadow: 0 4px 10px color-mix(in srgb, var(--family-accent) 32%, transparent);
  }

  .family-card small {
    color: var(--muted);
    font-size: 0.7rem;
    font-weight: 680;
    text-transform: uppercase;
  }

  .family-card h3 {
    margin: 0.2rem 0 0.46rem;
    color: var(--text);
    font-size: 1.02rem;
    letter-spacing: -0.02em;
  }

  .family-card p {
    margin: 0;
    color: var(--muted);
    font-size: 0.79rem;
    line-height: 1.56;
  }

  .family-card__arrow {
    color: var(--brand);
    font-size: 1.1rem;
  }

  .featured-section {
    padding-block: clamp(3.6rem, 6vw, 5.4rem);
    border-block: 1px solid var(--line);
    background:
      linear-gradient(rgba(238, 242, 245, 0.84), rgba(238, 242, 245, 0.84)),
      repeating-linear-gradient(90deg, transparent 0 79px, rgba(11, 39, 72, 0.05) 80px);
  }

  .featured-section__inner {
    display: grid;
    gap: 1.8rem;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .featured-section__action {
    display: flex;
    justify-content: center;
  }

  .process-section {
    display: grid;
    gap: 2rem;
  }

  .process-section__header {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.65fr);
    gap: 2rem;
    align-items: end;
  }

  .process-section__header > p {
    margin: 0;
    color: var(--muted);
    line-height: var(--body-leading);
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .process-grid a {
    display: grid;
    min-height: 18rem;
    align-content: start;
    gap: 0.65rem;
    padding: 1.2rem;
    border-top: 4px solid var(--brand);
    color: var(--copy);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .process-grid a:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card-hover);
  }

  .process-card__index {
    margin-bottom: 2rem;
    color: #a4b2bf;
    font-size: 0.72rem;
    font-weight: 740;
  }

  .process-grid p {
    margin: 0;
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 780;
    letter-spacing: 0.1em;
  }

  .process-grid h3 {
    margin: 0;
    color: var(--text);
    font-size: 1.1rem;
    line-height: 1.24;
    letter-spacing: -0.02em;
  }

  .process-grid a > span:not(.process-card__index) {
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.6;
  }

  .process-grid strong {
    margin-top: auto;
    padding-top: 1.2rem;
    color: var(--brand);
    font-size: 0.78rem;
  }

  .network-section {
    color: #fff;
    background:
