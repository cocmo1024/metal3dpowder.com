---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { buildCollectionPageSchema, buildOrganizationSchema, buildWebsiteSchema } from '../data/seo';
import { siteInfo } from '../data/site';
import { getProductPath, productFamilies, productProcesses, products } from '../data/products';
import { getProductSearchIntent } from '../data/searchIntent';

const title = 'Metal Powder for 3D Printing & Additive Manufacturing';
const description =
  'Find metal powder by exact alloy grade, process, particle size, and lot evidence. Review Ti6Al4V, IN718, 316L, AlSi10Mg, CuCrZr, and send a technical RFQ.';

const siteUrl = Astro.site ?? new URL('https://metal3dpowder.com');
const titaniumProducts = products.filter((product) => product.family === 'titanium');
const heroProducts = ['ti64', 'in718', 'cucrzr']
  .map((id) => products.find((product) => product.id === id))
  .filter((product): product is (typeof products)[number] => Boolean(product));
const explorationLinks = [
  {
    label: 'Process routes',
    title: 'Match PSD and powder behavior to the process',
    description: 'LPBF, EBM, DED, binder jet, MIM, and PM-HIP selection paths.',
    href: '/processes/',
  },
  {
    label: 'Applications',
    title: 'Start from the part and service environment',
    description: 'Aerospace, medical, energy, tooling, thermal, and industrial hardware.',
    href: '/applications/',
  },
  {
    label: 'Quality model',
    title: 'Define the evidence required for acceptance',
    description: 'Chemistry, PSD, flow, morphology, lot traceability, and agreed documents.',
    href: '/quality/',
  },
  {
    label: 'Engineering guides',
    title: 'Resolve technical decisions after choosing a grade',
    description: 'Detailed specifications, comparisons, applications, and sourcing guidance.',
    href: '/knowledge/',
  },
];

const collectionPageSchema = buildCollectionPageSchema({
  site: siteUrl,
  path: '/',
  name: 'Metal powder product catalog and sourcing portal',
  description,
  items: products.map((product) => ({
    name: getProductSearchIntent(product.id).primaryQuery,
    path: getProductPath(product),
  })),
});
---

<BaseLayout
  title={title}
  description={description}
  canonical="/"
  ogImageAlt="Metal powder product catalog"
  schema={[buildWebsiteSchema(siteUrl), buildOrganizationSchema(siteUrl), collectionPageSchema]}
>
  <SiteHeader pathname={Astro.url.pathname} />

  <main id="main-content">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__inner page-shell">
        <div class="hero__copy">
          <p class="hero__eyebrow">Metal powder sourcing for additive manufacturing</p>
          <h1 id="hero-title">Find the exact metal powder grade. Build a quote-ready RFQ.</h1>
          <p class="hero__lead">
            Choose the alloy first, review process and particle-size options on one grade page, then send the quantity,
            destination, and evidence requirements for a source-reviewed quotation.
          </p>

          <div class="hero__actions">
            <a class="button button--hero" href="#powder-finder">Find my powder</a>
            <a class="button button--dark" href="/rfq/">Send powder RFQ</a>
          </div>

          <nav class="hero__titanium" aria-label="Direct titanium powder routes">
            <span>Looking for titanium?</span>
            {
              titaniumProducts.map((product) => (
                <a href={getProductPath(product)}>{product.code}</a>
              ))
            }
          </nav>

          <p class="hero__supply-chain">
            China-based supply coordination covering specification, source screening, lot evidence, packaging, and
            destination or export-route review where applicable.
          </p>
        </div>

        <div class="hero-showcase" aria-label="Representative exact-grade powder routes">
          <div class="hero-showcase__grid" aria-hidden="true"></div>
          {
            heroProducts.map((product, index) => (
              <a
                class={`hero-product hero-product--${['primary', 'secondary', 'tertiary'][index]}`}
                href={getProductPath(product)}
              >
                <img src={product.image} alt="" width="800" height="560" />
                <span>
                  <small>{product.familyLabel} route</small>
                  <strong>{product.code} · {product.processes.slice(0, 2).join(' / ')}</strong>
                </span>
              </a>
            ))
          }
          <div class="hero-showcase__note">
            <span>ONE GRADE, ONE DECISION PAGE</span>
            <p>Confirm aliases, process, PSD, evidence, and quote inputs without searching through generic content.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="proof-strip page-shell" aria-label="Catalog and quotation scope">
      <article>
        <strong>{products.length}</strong>
        <span>exact grade pages</span>
      </article>
      <article>
        <strong>{productFamilies.length}</strong>
        <span>alloy families</span>
      </article>
      <article>
        <strong>{productProcesses.length}</strong>
        <span>process routes</span>
      </article>
      <article>
        <strong>Lot-linked</strong>
        <span>quotation evidence</span>
      </article>
    </section>

    <section id="powder-finder" class="grade-finder page-shell" aria-labelledby="finder-title">
      <div class="grade-finder__header">
        <div class="section-heading">
          <p class="eyebrow">Exact-grade powder finder</p>
          <h2 id="finder-title">Go straight to the powder a buyer actually specifies.</h2>
          <p>
            Every grade below leads to a focused purchasing page with international designations, candidate PSDs,
            process routes, required evidence, and a preselected RFQ.
          </p>
        </div>
        <a href="/products/">Open full powder catalog →</a>
      </div>

      <nav class="family-links" aria-label="Browse alloy family pages">
        {
          productFamilies.map((family) => (
            <a href={family.hubPath} style={`--family-accent:${family.accent}`}>{family.label}</a>
          ))
        }
      </nav>

      <div class="grade-grid" aria-label="Available exact-grade powder pages">
        {
          products.map((product) => {
            const intent = getProductSearchIntent(product.id);
            return (
              <a class="grade-card" href={getProductPath(product)} style={`--grade-accent:${product.accent}`}>
                <span class="grade-card__family">{product.familyLabel}</span>
                <strong>{intent.primaryQuery}</strong>
                <small>{product.code}</small>
                <p>{product.particleSizes.slice(0, 2).join(' · ')} · {product.processes.slice(0, 3).join(' / ')}</p>
                <span class="grade-card__action">Review grade & RFQ <b aria-hidden="true">→</b></span>
              </a>
            );
          })
        }
      </div>
    </section>

    <section class="network-section" aria-labelledby="network-title">
      <div class="network-section__inner page-shell">
        <div class="network-section__copy">
          <p class="eyebrow">Supply-chain and export execution</p>
          <h2 id="network-title">A usable supply route—not a generic supplier list.</h2>
          <p>
            Powder production and testing capabilities are matched to the requested alloy, process, PSD, quantity,
            evidence package, commercial scope, and destination. The formal quotation identifies what is proposed and
            what still requires project confirmation.
          </p>

          <div class="capability-list" aria-label="Representative powder production routes">
            <span>VIGA / gas atomization</span>
            <span>EIGA</span>
            <span>PREP</span>
            <span>Plasma atomization</span>
          </div>

          <p class="network-section__boundary">
            Export feasibility depends on the actual powder, packing, transport mode, carrier, and destination. Route
            and document requirements are reviewed for the quotation where applicable; they are not presented as a
            universal shipping guarantee.
          </p>

          <div class="network-section__actions">
            <a class="button button--hero" href="/rfq/">Start a powder RFQ</a>
            <a class="network-section__link" href="/about/">How the sourcing model works →</a>
          </div>
        </div>

        <ol class="sourcing-steps" aria-label="Four-gate supply route review">
          <li>
            <span>01</span>
            <div>
              <strong>Specification gate</strong>
              <p>Confirm grade, chemistry version, process, PSD method, quantity, and acceptance criteria.</p>
            </div>
          </li>
          <li>
            <span>02</span>
            <div>
              <strong>Evidence gate</strong>
              <p>Match COA, PSD, chemistry, morphology, traceability, and other agreed evidence to the route.</p>
            </div>
          </li>
          <li>
            <span>03</span>
            <div>
              <strong>Commercial gate</strong>
              <p>Review quantity, availability, packaging, timing, terms, and repeat-supply requirements.</p>
            </div>
          </li>
          <li>
            <span>04</span>
            <div>
              <strong>Export gate</strong>
              <p>Review identity or classification basis, packing, documents, carrier, and destination where needed.</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section class="explore-section page-shell" aria-labelledby="explore-title">
      <div class="explore-section__header">
        <div class="section-heading">
          <p class="eyebrow">Technical depth when you need it</p>
          <h2 id="explore-title">Keep the homepage fast. Continue into the right decision center.</h2>
        </div>
        <p>Detailed SEO and engineering content remains available one level deeper, organized around a real buying task.</p>
      </div>

      <div class="explore-grid">
        {
          explorationLinks.map((item, index) => (
            <a href={item.href}>
              <span>{String(index + 1).padStart(2, '0')} · {item.label}</span>
              <strong>{item.title}</strong>
              <p>{item.description}</p>
              <b>Open center →</b>
            </a>
          ))
        }
      </div>
    </section>

    <section class="final-cta page-shell" aria-labelledby="final-cta-title">
      <div>
        <p class="eyebrow">Technical and commercial RFQ</p>
        <h2 id="final-cta-title">Know the grade already? Send the requirement now.</h2>
        <p>
          Add a catalog grade or describe a custom chemistry. Include the process, PSD, quantity, destination, timing,
          and required documents; unresolved fields can remain open for technical review.
        </p>
      </div>
      <div class="final-cta__actions">
        <a class="button button--hero" href="/rfq/">Open RFQ <span data-rfq-count data-empty>0</span></a>
        <a class="button button--dark" href={`mailto:${siteInfo.email}`}>Email sales</a>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    color: #fff;
    background:
      radial-gradient(circle at 80% 20%, rgba(33, 113, 184, 0.34), transparent 26rem),
      radial-gradient(circle at 15% 120%, rgba(214, 102, 44, 0.18), transparent 30rem),
      linear-gradient(135deg, #081b2f 0%, #0b2c4e 57%, #0a223b 100%);
  }

  .hero::before {
    position: absolute;
    inset: 0;
    content: '';
    pointer-events: none;
    opacity: 0.14;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.16) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.16) 1px, transparent 1px);
    background-size: 88px 88px;
    mask-image: linear-gradient(90deg, transparent, #000 55%, #000);
  }

  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(26rem, 0.92fr);
    min-height: 31rem;
    align-items: center;
    gap: clamp(2rem, 4vw, 4rem);
    padding-block: clamp(3rem, 5vw, 4.4rem);
  }

  .hero__copy {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 1rem;
    max-width: 47rem;
  }

  .hero__eyebrow {
    margin: 0;
    color: #8fc9ff;
    font-size: 0.82rem;
    font-weight: 760;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero h1 {
    max-width: 45rem;
    margin: 0;
    color: #fff;
    font-size: clamp(2.65rem, 4.3vw, 3.8rem);
    font-weight: 720;
    line-height: 1.02;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .hero__lead {
    max-width: 43rem;
    margin: 0;
    color: #c7d5e0;
    font-size: clamp(1rem, 1.25vw, 1.1rem);
    line-height: 1.65;
  }

  .hero__actions,
  .network-section__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .button--hero {
    color: #fff;
    border-color: var(--accent);
    background: var(--accent);
    box-shadow: 0 10px 24px rgba(214, 102, 44, 0.2);
  }

  .button--hero:hover {
    border-color: #ba5220;
    background: #ba5220;
  }

  .hero__titanium {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    align-items: center;
  }

  .hero__titanium > span {
    margin-right: 0.12rem;
    color: #fff;
    font-size: 0.86rem;
    font-weight: 760;
  }

  .hero__titanium a {
    padding: 0.34rem 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 0.42rem;
    color: #d9e8f4;
    background: rgba(255, 255, 255, 0.055);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .hero__titanium a:hover {
    color: #fff;
    border-color: rgba(143, 201, 255, 0.7);
    background: rgba(143, 201, 255, 0.12);
  }

  .hero__supply-chain {
    max-width: 44rem;
    margin: 0;
    padding-left: 0.85rem;
    border-left: 3px solid var(--accent-warm);
    color: #9fb5c7;
    font-size: 0.84rem;
    line-height: 1.55;
  }

  .hero-showcase {
    position: relative;
    min-height: 26rem;
    perspective: 1000px;
  }

  .hero-showcase__grid {
    position: absolute;
    inset: 2rem 0 0 4rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 50%;
    transform: rotateX(65deg) rotateZ(-9deg);
    background:
      repeating-radial-gradient(circle, transparent 0 2rem, rgba(116, 185, 248, 0.11) 2.06rem 2.12rem),
      repeating-linear-gradient(90deg, transparent 0 2.8rem, rgba(116, 185, 248, 0.09) 2.86rem 2.92rem);
  }

  .hero-product {
    position: absolute;
    display: grid;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 0.8rem;
    background: rgba(8, 20, 33, 0.76);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(12px);
    transition: transform 180ms ease, border-color 180ms ease;
  }

  .hero-product:hover {
    z-index: 7;
    border-color: rgba(255, 255, 255, 0.46);
    transform: translateY(-4px) rotate(0deg);
  }

  .hero-product img {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: cover;
  }

  .hero-product > span {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: grid;
    gap: 0.14rem;
    padding: 0.68rem 0.75rem;
    background: linear-gradient(180deg, transparent, rgba(5, 13, 22, 0.95) 34%);
  }

  .hero-product small {
    color: #93a9bd;
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-product strong {
    color: #fff;
    font-size: 0.86rem;
  }

  .hero-product--primary {
    z-index: 3;
    top: 0.8rem;
    left: 3.8rem;
    width: min(60%, 20rem);
    aspect-ratio: 10 / 7;
    transform: rotate(-3deg);
  }

  .hero-product--secondary {
    z-index: 2;
    top: 7.8rem;
    right: 0.5rem;
    width: min(52%, 17rem);
    aspect-ratio: 10 / 7;
    transform: rotate(4deg);
  }

  .hero-product--tertiary {
    z-index: 4;
    bottom: 0;
    left: 0;
    width: min(46%, 15rem);
    aspect-ratio: 10 / 7;
    transform: rotate(2deg);
  }

  .hero-showcase__note {
    position: absolute;
    z-index: 6;
    right: 0.5rem;
    bottom: 0.4rem;
    display: grid;
    max-width: 14.5rem;
    gap: 0.32rem;
    padding: 0.8rem 0.9rem;
    border-left: 3px solid var(--accent);
    color: #fff;
    background: rgba(7, 22, 37, 0.92);
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.25);
  }

  .hero-showcase__note span {
    color: #82c5ff;
    font-size: 0.72rem;
    font-weight: 760;
    letter-spacing: 0.11em;
  }

  .hero-showcase__note p {
    margin: 0;
    color: #b9c9d7;
    font-size: 0.8rem;
    line-height: 1.45;
  }

  .proof-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: -1.9rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }

  .proof-strip article {
    display: grid;
    gap: 0.18rem;
    padding: 1rem 1.25rem;
    border-right: 1px solid var(--line);
  }

  .proof-strip article:last-child {
    border-right: 0;
  }

  .proof-strip strong {
    color: var(--brand-dark);
    font-size: clamp(1.1rem, 1.8vw, 1.38rem);
    line-height: 1.1;
  }

  .proof-strip span {
    color: var(--muted);
    font-size: 0.82rem;
  }

  .grade-finder {
    display: grid;
    gap: 1.3rem;
    scroll-margin-top: 7rem;
  }

  .grade-finder__header,
  .explore-section__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }

  .grade-finder__header > a {
    flex: 0 0 auto;
    color: var(--brand);
    font-size: 0.9rem;
    font-weight: 760;
  }

  .family-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .family-links a {
    padding: 0.45rem 0.68rem;
    border: 1px solid var(--line);
    border-left: 3px solid var(--family-accent);
    border-radius: 0.45rem;
    color: var(--text);
    background: var(--surface);
    font-size: 0.84rem;
    font-weight: 700;
  }

  .family-links a:hover {
    color: var(--brand);
    border-color: color-mix(in srgb, var(--family-accent) 58%, var(--line));
  }

  .grade-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .grade-card {
    position: relative;
    display: grid;
    min-height: 11.2rem;
    align-content: start;
    gap: 0.35rem;
    padding: 1rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-top: 3px solid var(--grade-accent);
    border-radius: 0.65rem;
    color: var(--text);
    background: var(--surface);
    box-shadow: 0 4px 16px rgba(12, 39, 65, 0.04);
    transition: transform 170ms ease, border-color 170ms ease, box-shadow 170ms ease;
  }

  .grade-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--grade-accent) 54%, var(--line));
    box-shadow: var(--shadow-card);
  }

  .grade-card__family {
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 760;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .grade-card > strong {
    font-size: 1.02rem;
    line-height: 1.25;
  }

  .grade-card > small {
    color: var(--brand);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .grade-card p {
    margin: 0.12rem 0 0;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .grade-card__action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.6rem;
    color: var(--brand);
    font-size: 0.82rem;
    font-weight: 760;
  }

  .network-section {
    color: #fff;
    background:
      radial-gradient(circle at 5% 50%, rgba(214, 102, 44, 0.14), transparent 28rem),
      linear-gradient(120deg, #0a2139, #0b2f53);
  }

  .network-section .eyebrow,
  .final-cta .eyebrow {
    color: var(--accent-warm);
  }

  .network-section__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(27rem, 1.1fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
    padding-block: clamp(3.8rem, 6vw, 5.5rem);
  }

  .network-section__copy {
    display: grid;
    justify-items: start;
    gap: 1rem;
  }

  .network-section h2 {
    margin: 0;
    color: #fff;
    font-size: clamp(2rem, 3.4vw, 3.1rem);
    line-height: 1.04;
    letter-spacing: -0.038em;
  }

  .network-section__copy > p:nth-of-type(2) {
    margin: 0;
    color: #b9c9d7;
    line-height: 1.7;
  }

  .capability-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .capability-list span {
    padding: 0.42rem 0.58rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 0.42rem;
    color: #dce8f2;
    background: rgba(255, 255, 255, 0.05);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .network-section__boundary {
    margin: 0;
    padding-left: 0.85rem;
    border-left: 2px solid rgba(143, 201, 255, 0.72);
    color: #96adbf;
    font-size: 0.82rem;
    line-height: 1.58;
  }

  .network-section__actions {
    align-items: center;
  }

  .network-section__link {
    color: #fff;
    font-size: 0.86rem;
    font-weight: 760;
  }

  .network-section__link:hover {
    color: #9ed0ff;
  }

  .sourcing-steps {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 0.8rem;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.045);
  }

  .sourcing-steps li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    padding: 1.05rem 1.15rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .sourcing-steps li:last-child {
    border-bottom: 0;
  }

  .sourcing-steps li > span {
    display: inline-flex;
    width: 2rem;
    height: 2rem;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: #fff;
    background: var(--accent);
    font-size: 0.8rem;
    font-weight: 760;
  }

  .sourcing-steps div {
    display: grid;
    gap: 0.2rem;
  }

  .sourcing-steps strong {
    color: #fff;
    font-size: 0.95rem;
  }

  .sourcing-steps p {
    margin: 0;
    color: #aebfce;
    font-size: 0.86rem;
    line-height: 1.52;
  }

  .explore-section {
    display: grid;
