---
import { getCollection } from 'astro:content';
import ContentHub from '../../components/ContentHub.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBlogPostPath, sortBlogPosts, type BlogPost } from '../../data/blog';
import { processHubs, type HubDefinition } from '../../data/contentHubs';
import { getProductsForHub } from '../../data/productRoutes';
import { getProductPath } from '../../data/products';
import { buildBreadcrumbSchema, buildCollectionPageSchema } from '../../data/seo';

interface Props {
  hub: HubDefinition;
}

export function getStaticPaths() {
  return processHubs.map((hub) => ({
    params: { slug: hub.slug },
    props: { hub },
  }));
}

const { hub } = Astro.props;
const allPosts = sortBlogPosts(await getCollection('blog'));
const postMap = new Map(allPosts.map((post) => [post.id, post]));
const posts = hub.postIds.map((id) => postMap.get(id)).filter((post): post is BlogPost => Boolean(post));
const relatedProducts = getProductsForHub(hub);
const canonical = `/processes/${hub.slug}/`;
const processName = hub.title.replace(/ Powder$/, '');
const seoTitle = `${processName} Metal Powder | Particle Size & Alloy Selection`;
const pageHeading = `${processName} metal powder for additive manufacturing`;
const metaDescription = `Compare ${processName} metal powder by alloy grade, particle size, flow, morphology, chemistry, qualification evidence, and RFQ requirements.`;
const siteUrl = Astro.site ?? new URL('https://metal3dpowder.com');
const breadcrumbItems = [
  { name: 'Home', path: '/' },
  { name: 'Processes', path: '/processes/' },
  { name: hub.title },
];
const schema = [
  buildCollectionPageSchema({
    site: siteUrl,
    path: canonical,
    name: pageHeading,
    description: metaDescription,
    items: [
      ...relatedProducts.map((product) => ({ name: product.name, path: getProductPath(product) })),
      ...posts.map((post) => ({ name: post.data.title, path: getBlogPostPath(post) })),
    ],
  }),
  buildBreadcrumbSchema(siteUrl, breadcrumbItems),
];
---

<BaseLayout title={seoTitle} description={metaDescription} canonical={canonical} schema={schema}>
  <SiteHeader pathname={Astro.url.pathname} />
  <ContentHub
    breadcrumbItems={breadcrumbItems}
    eyebrow="Process center"
    title={pageHeading}
    description={hub.description}
    decisionGuide={hub.decisionGuide}
    products={relatedProducts}
    productsTitle={`Alloy-grade powder routes for ${processName}`}
    posts={posts}
    postsTitle={`${processName} particle-size, qualification, and application guides`}
    intentLayer="process"
  />
  <SiteFooter />
</BaseLayout>
