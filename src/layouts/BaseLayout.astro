---
import '../styles/global.css';
import { siteInfo } from '../data/site';
import { defaultOgImagePath, rssFeedPath } from '../data/seo';

interface Props {
  title: string;
  description: string;
  author?: string;
  canonical: string | null;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogType?: string;
  robots?: string;
  extraMeta?: Array<{
    name?: string;
    property?: string;
    content: string;
  }>;
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description,
  author = siteInfo.brand,
  canonical,
  ogImage = defaultOgImagePath,
  ogImageAlt = title,
  ogImageWidth,
  ogImageHeight,
  ogType = 'website',
  robots = 'index,follow,max-image-preview:large',
  extraMeta = [],
  schema = [],
} = Astro.props;

const site = Astro.site ?? new URL('https://metal3dpowder.com');
const canonicalUrl = canonical ? new URL(canonical, site).toString() : null;
const ogImageUrl = new URL(ogImage, site).toString();
const ogImageExtension = ogImageUrl.split(/[?#]/)[0]?.split('.').pop()?.toLowerCase();
const ogImageType =
  ogImageExtension === 'webp'
    ? 'image/webp'
    : ogImageExtension === 'svg'
      ? 'image/svg+xml'
      : ogImageExtension === 'jpg' || ogImageExtension === 'jpeg'
        ? 'image/jpeg'
        : 'image/png';
const resolvedOgImageWidth = ogImageWidth ?? (ogImage === defaultOgImagePath ? 1200 : undefined);
const resolvedOgImageHeight = ogImageHeight ?? (ogImage === defaultOgImagePath ? 630 : undefined);
const schemaItems = Array.isArray(schema) ? schema : [schema];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="author" content={author} />
    <meta name="theme-color" content="#0b2748" />
    {canonicalUrl ? <link rel="canonical" href={canonicalUrl} /> : null}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {canonicalUrl ? <link rel="alternate" hreflang="en" href={canonicalUrl} /> : null}
    {canonicalUrl ? <link rel="alternate" hreflang="x-default" href={canonicalUrl} /> : null}
    <link rel="alternate" type="application/rss+xml" title={`${siteInfo.brand} Blog Feed`} href={new URL(rssFeedPath, site).toString()} />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl ? <meta property="og:url" content={canonicalUrl} /> : null}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content={ogImageType} />
    {resolvedOgImageWidth ? <meta property="og:image:width" content={String(resolvedOgImageWidth)} /> : null}
    {resolvedOgImageHeight ? <meta property="og:image:height" content={String(resolvedOgImageHeight)} /> : null}
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content={siteInfo.brand} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {extraMeta.map((meta) => (
      <meta {...(meta.name ? { name: meta.name } : {})} {...(meta.property ? { property: meta.property } : {})} content={meta.content} />
    ))}

    {schemaItems.map((item) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(item)} />
    ))}

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />

    <script>
      (() => {
        const storageKey = 'metal3dpowder:rfq-products';
        let memoryProducts: string[] = [];
        const analyticsWindow = window as typeof window & {
          dataLayer?: Array<Record<string, unknown>>;
        };
        const allowedAnalyticsEvents = new Set([
          'add_to_rfq',
          'begin_rfq',
          'generate_lead',
          'mailto_click',
          'remove_from_rfq',
          'select_product',
          'select_rfq',
        ]);
        const allowedAnalyticsParameters = new Set([
          'entry_point',
          'page_path',
          'product_count',
          'product_id',
          'products',
          'source_path',
          'submission_id',
        ]);

        const emitAnalytics = (eventName: string, parameters: Record<string, unknown> = {}) => {
          if (!allowedAnalyticsEvents.has(eventName)) return;

          const safeParameters = Object.fromEntries(
            Object.entries(parameters)
              .filter(([key, value]) => allowedAnalyticsParameters.has(key) && ['string', 'number', 'boolean'].includes(typeof value))
              .map(([key, value]) => [key, typeof value === 'string' ? value.slice(0, 250) : value])
          );
          const payload = {
            event: eventName,
            ...safeParameters,
          };

          analyticsWindow.dataLayer ??= [];
          analyticsWindow.dataLayer.push(payload);
          window.dispatchEvent(new CustomEvent('metal3dpowder:analytics', { detail: payload }));
        };

        window.addEventListener('metal3dpowder:track', (event) => {
          if (!(event instanceof CustomEvent) || !event.detail || typeof event.detail !== 'object') return;
          const { event: eventName, ...parameters } = event.detail as Record<string, unknown>;
          if (typeof eventName === 'string') emitAnalytics(eventName, parameters);
        });

        const readProducts = (): string[] => {
          try {
            const value: unknown = JSON.parse(window.localStorage.getItem(storageKey) || '[]');
            memoryProducts = Array.isArray(value)
              ? value.filter((item): item is string => typeof item === 'string')
              : [];
            return memoryProducts;
          } catch {
            return memoryProducts;
          }
        };

        const writeProducts = (products: string[]) => {
          memoryProducts = [...new Set(products)];
          try {
            window.localStorage.setItem(storageKey, JSON.stringify(memoryProducts));
          } catch {
            // Keep the list in memory when browser storage is unavailable.
          }
          window.dispatchEvent(new CustomEvent('metal3dpowder:rfq-change'));
        };

        const sync = () => {
          const products = readProducts();
          document.querySelectorAll('[data-rfq-count]').forEach((node) => {
            node.textContent = String(products.length);
            node.toggleAttribute('data-empty', products.length === 0);
          });

          document.querySelectorAll('[data-add-product]').forEach((node) => {
            const productId = node.getAttribute('data-add-product');
            const added = Boolean(productId && products.includes(productId));
            const productName = node.getAttribute('data-product-name') || 'this powder';
            if (!node.getAttribute('data-default-label')) {
              node.setAttribute('data-default-label', node.textContent?.trim() || 'Add to RFQ');
            }
            node.setAttribute('data-added', String(added));
            node.setAttribute('aria-pressed', String(added));
            node.setAttribute(
              'aria-label',
              added ? `Remove ${productName} from the RFQ list` : `Add ${productName} to the RFQ list`
            );
            node.textContent = added ? 'Remove from RFQ' : node.getAttribute('data-default-label');
          });
        };

        document.addEventListener('click', (event) => {
          const target = event.target instanceof Element ? event.target.closest('[data-add-product]') : null;
          if (!target) return;

          const productId = target.getAttribute('data-add-product');
          if (!productId) return;

          const products = readProducts();
          if (!products.includes(productId)) {
            writeProducts([...products, productId]);
            emitAnalytics('add_to_rfq', {
              product_id: productId,
              product_count: products.length + 1,
              page_path: window.location.pathname,
            });
          } else {
            writeProducts(products.filter((item) => item !== productId));
            emitAnalytics('remove_from_rfq', {
              product_id: productId,
              product_count: Math.max(0, products.length - 1),
              page_path: window.location.pathname,
            });
          }
        });

        document.addEventListener('click', (event) => {
          const link = event.target instanceof Element ? event.target.closest('a[href]') : null;
          if (!(link instanceof HTMLAnchorElement)) return;

          const productId = link.getAttribute('data-product-route');
          if (productId) {
            emitAnalytics('select_product', {
              product_id: productId,
              entry_point: 'contextual_product_route',
              page_path: window.location.pathname,
            });
            return;
          }

          if (link.protocol === 'mailto:') {
            emitAnalytics('mailto_click', { page_path: window.location.pathname });
            return;
          }

          if (link.origin === window.location.origin && link.pathname.startsWith('/rfq/')) {
            emitAnalytics('select_rfq', {
              entry_point: link.getAttribute('data-rfq-entry') || 'site_link',
              page_path: window.location.pathname,
            });
          }
        });

        window.addEventListener('storage', sync);
        window.addEventListener('metal3dpowder:rfq-change', sync);
        sync();

        try {
          const attributionKey = 'metal3dpowder:attribution';
          const allowedQueryKeys = [
            'gclid',
            'gbraid',
            'wbraid',
            'utm_source',
            'utm_medium',
            'utm_campaign',
            'utm_term',
            'utm_content',
          ];
          const stored = JSON.parse(window.localStorage.getItem(attributionKey) || '{}');
          const currentQuery = new URLSearchParams(window.location.search);
          const retainedQuery = new URLSearchParams();
          const next = stored && typeof stored === 'object' ? { ...stored } : {};

          allowedQueryKeys.forEach((key) => {
            const value = currentQuery.get(key);
            if (value) {
              next[key] = value.slice(0, 500);
              retainedQuery.set(key, value.slice(0, 500));
            }
          });

          const landing = `${window.location.pathname}${retainedQuery.size ? `?${retainedQuery}` : ''}`;
          const now = new Date().toISOString();
          if (!next.first_landing_page) next.first_landing_page = landing;
          if (!next.captured_at) next.captured_at = now;
          next.last_landing_page = landing;
          next.updated_at = now;

          if (!next.referrer && document.referrer) {
            try {
              next.referrer = new URL(document.referrer).origin;
            } catch {
              // Ignore invalid referrer values.
            }
          }

          window.localStorage.setItem(attributionKey, JSON.stringify(next));
        } catch {
          // Attribution must never block navigation or RFQ interaction.
        }
      })();
    </script>
  </body>
</html>
