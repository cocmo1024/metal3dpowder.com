---
interface HubCard {
  title: string;
  description: string;
  href: string;
}

interface Props {
  items: HubCard[];
  ariaLabel?: string;
}

const { items, ariaLabel = 'Topic hubs' } = Astro.props;
---

<section class="hub-card-grid" aria-label={ariaLabel}>
  {items.map((item) => (
    <article class="hub-card">
      <h2><a href={item.href}>{item.title}</a></h2>
      <p>{item.description}</p>
    </article>
  ))}
</section>

<style>
  .hub-card-grid {
    display: grid;
    gap: 1.15rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .hub-card {
    position: relative;
    display: grid;
    gap: 0.7rem;
    align-content: start;
    min-height: 11.5rem;
    padding: var(--card-padding);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--card-bg);
    box-shadow: var(--shadow-card);
    transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
  }

  .hub-card h2 {
    margin: 0;
    font-size: 1.18rem;
    line-height: 1.28;
    letter-spacing: -0.016em;
  }

  .hub-card p {
    margin: 0;
    color: var(--muted);
    line-height: var(--body-leading);
    font-size: 0.98rem;
  }

  .hub-card h2 a::after {
    position: absolute;
    inset: 0;
    content: '';
  }

  .hub-card:hover,
  .hub-card:focus-within {
    transform: translateY(-2px);
    border-color: var(--brand);
    box-shadow: var(--shadow-card-hover);
  }

  .hub-card a:hover,
  .hub-card:focus-within a {
    color: var(--accent);
  }

  @media (max-width: 980px) {
    .hub-card-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .hub-card-grid {
      grid-template-columns: 1fr;
    }

    .hub-card {
      min-height: 0;
    }
  }
</style>
