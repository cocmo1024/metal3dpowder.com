---
import { buildRfqEmailHref } from '../data/contact';

interface Props {
  context?: string;
  variant?: 'article' | 'hub';
}

const { context = 'this powder topic', variant = 'article' } = Astro.props;
const titleId = `rfq-cta-title-${variant}`;
const isHub = variant === 'hub';
const heading = isHub
  ? 'Request pricing and availability'
  : 'Need a powder quote for this application?';
const copy = isHub
  ? 'Shortlist a material, then send the process, particle size, quantity, destination, application, and documentation requirements for review.'
  : 'To request powder for this application, send the alloy grade, process, PSD target, quantity, destination country, and any oxygen, documentation, or packaging requirements.';
const emailHref = buildRfqEmailHref(context);
---

<section class={`rfq-cta rfq-cta--${variant}`} aria-labelledby={titleId}>
  <div class="rfq-cta__copy">
    <p class="eyebrow">Powder RFQ</p>
    <h2 id={titleId}>{heading}</h2>
    <p>{copy}</p>
  </div>

  <ul class="rfq-cta__details" aria-label="Useful RFQ details">
    <li>Alloy grade and target process: LPBF, EBM, DED, binder jetting, or MIM</li>
    <li>Particle size range, chemistry limits, and document needs</li>
    <li>Trial or production quantity, destination, and target timing</li>
  </ul>

  <div class="rfq-cta__actions" aria-label="RFQ actions">
    <a class="button button--primary" href="/rfq/">Request a quote</a>
    <a class="button button--ghost" href={emailHref}>Email sales</a>
  </div>
</section>

<style>
  .rfq-cta {
    display: grid;
    gap: 1rem;
    padding: var(--card-padding);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--brand) 6.5%, transparent),
        color-mix(in srgb, var(--accent) 4.5%, transparent)
      ),
      var(--surface);
    box-shadow: var(--shadow-card);
  }

  .rfq-cta__copy {
    display: grid;
    gap: 0.55rem;
  }

  .rfq-cta h2,
  .rfq-cta p,
  .rfq-cta ul {
    margin: 0;
  }

  .rfq-cta h2 {
    font-size: clamp(1.08rem, 1.55vw, 1.28rem);
    line-height: 1.24;
    letter-spacing: -0.02em;
    font-weight: 720;
  }

  .rfq-cta__copy p:last-child,
  .rfq-cta__details {
    color: var(--copy);
    font-size: 0.96rem;
    line-height: var(--body-leading);
  }

  .rfq-cta__details {
    display: grid;
    gap: 0.38rem;
    padding-left: 1.15rem;
  }

  .rfq-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.68rem;
    align-items: center;
  }

  .rfq-cta__actions .button {
    min-height: 2.8rem;
    max-width: 100%;
    padding: 0.72rem 1rem;
    text-align: center;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  @media (min-width: 820px) {
    .rfq-cta {
      grid-template-columns: minmax(0, 1.4fr) minmax(15rem, 0.8fr);
      align-items: center;
    }

    .rfq-cta__copy,
    .rfq-cta__actions {
      grid-column: 1;
    }

    .rfq-cta__details {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }

  @media (max-width: 520px) {
    .rfq-cta__actions {
      display: grid;
    }
  }
</style>
