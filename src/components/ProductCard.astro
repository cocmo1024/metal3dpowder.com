---
import { getProductPath, type Product } from '../data/products';
import { getProductSearchIntent } from '../data/searchIntent';

interface Props {
  product: Product;
  index?: number;
}

const { product, index = 0 } = Astro.props;
const productPath = getProductPath(product);
const searchIntent = getProductSearchIntent(product.id);
const searchableText = [
  searchIntent.primaryQuery,
  product.name,
  product.code,
  product.familyLabel,
  ...product.aliases,
  ...product.processes,
  ...product.applications,
  ...searchIntent.buyerQueries,
].join(' ');
---

<article
  class="product-card"
  data-product-card
  data-family={product.family}
  data-processes={product.processes.join('|')}
  data-applications={product.applications.join('|')}
  data-search={searchableText.toLowerCase()}
  data-primary-query={searchIntent.primaryQuery}
  style={`--card-accent:${product.accent}; --card-delay:${Math.min(index, 7) * 45}ms;`}
>
  <a class="product-card__media" href={productPath} aria-label={`View ${product.name}`}>
    <img
      src={product.image}
      alt={`${product.name} powder product illustration`}
      width="800"
      height="560"
      loading={index < 3 ? 'eager' : 'lazy'}
      decoding="async"
    />
    <span class="product-card__family">{product.familyLabel}</span>
  </a>

  <div class="product-card__body">
    <div class="product-card__heading">
      <div>
        <p class="product-card__code">{product.code}</p>
        <h3><a href={productPath}>{product.name}</a></h3>
      </div>
      <span class="product-card__availability">{product.availabilityLabel}</span>
    </div>

    <p class="product-card__summary">{product.summary}</p>
    <p class="product-card__search-name">
      <span>Primary grade search</span>
      <strong>{searchIntent.primaryQuery}</strong>
    </p>

    <dl class="product-card__specs">
      <div>
        <dt>PSD options</dt>
        <dd>{product.particleSizes.slice(0, 2).join(' · ')}</dd>
      </div>
      <div>
        <dt>Supported processes</dt>
        <dd>{product.processes.slice(0, 3).join(' · ')}</dd>
      </div>
    </dl>

    <ul class="product-card__markets" aria-label={`${product.name} markets`}>
      {product.applications.slice(0, 3).map((application) => <li>{application}</li>)}
    </ul>

    <div class="product-card__footer">
      <div>
        <small>Quotation basis</small>
        <strong>{product.orderLabel}</strong>
      </div>
      <div class="product-card__actions">
        <a class="product-card__details" href={productPath}>Details</a>
        <button
          class="product-card__add"
          type="button"
          data-add-product={product.id}
          data-product-name={product.name}
          aria-label={`Add ${product.name} to RFQ list`}
        >
          Add to RFQ
        </button>
      </div>
    </div>
  </div>
</article>

<style>
  .product-card {
    display: grid;
    min-width: 0;
    overflow: clip;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    animation: card-rise 440ms cubic-bezier(0.2, 1, 0.22, 1) both;
    animation-delay: var(--card-delay);
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .product-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--card-accent) 55%, var(--line));
    box-shadow: var(--shadow-card-hover);
  }

  .product-card__media {
    position: relative;
    display: block;
    aspect-ratio: 10 / 6.3;
    overflow: hidden;
    background: #0b1219;
  }

  .product-card__media::after {
    position: absolute;
    inset: 0;
    content: '';
    pointer-events: none;
    background: linear-gradient(180deg, transparent 55%, rgba(4, 9, 14, 0.42));
  }

  .product-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 240ms ease;
  }

  .product-card:hover .product-card__media img {
    transform: scale(1.025);
  }

  .product-card__family {
    position: absolute;
    z-index: 1;
    top: 0.8rem;
    left: 0.8rem;
    padding: 0.38rem 0.62rem;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    color: #fff;
    background: rgba(4, 9, 14, 0.64);
    backdrop-filter: blur(10px);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .product-card__body {
    display: grid;
    gap: 0.9rem;
    padding: 1rem;
  }

  .product-card__heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.75rem;
    align-items: start;
  }

  .product-card__code {
    margin: 0;
    color: var(--brand);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .product-card h3 {
    margin: 0.2rem 0 0;
    color: var(--text);
    font-size: 1.15rem;
    line-height: 1.22;
    letter-spacing: -0.022em;
  }

  .product-card__availability {
    padding: 0.38rem 0.56rem;
    border-radius: 0.45rem;
    color: var(--success-text);
    background: var(--success-bg);
    font-size: 0.75rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .product-card__summary {
    min-height: 4.5rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.62;
  }

  .product-card__search-name {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.55rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.76rem;
  }

  .product-card__search-name strong {
    color: var(--text);
    font-weight: 700;
  }

  .product-card__specs {
    display: grid;
    gap: 0.62rem;
    margin: 0;
  }

  .product-card__specs div {
    display: grid;
    grid-template-columns: 6.1rem minmax(0, 1fr);
    gap: 0.65rem;
    align-items: baseline;
    padding-top: 0.62rem;
    border-top: 1px solid var(--line);
  }

  .product-card__specs dt {
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .product-card__specs dd {
    margin: 0;
    color: var(--text);
    font-size: 0.86rem;
    font-weight: 600;
    text-align: right;
  }

  .product-card__markets {
    display: flex;
    flex-wrap: wrap;
    gap: 0.42rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .product-card__markets li {
    padding: 0.32rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    background: var(--surface-soft);
    font-size: 0.74rem;
  }

  .product-card__footer {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.7rem;
    align-items: end;
    padding-top: 0.8rem;
    border-top: 1px solid var(--line);
  }

  .product-card__footer > div:first-child {
    display: grid;
    gap: 0.12rem;
  }

  .product-card__footer small {
    color: var(--muted);
    font-size: 0.75rem;
  }

  .product-card__footer strong {
    color: var(--text);
    font-size: 0.88rem;
  }

  .product-card__actions {
    display: flex;
    gap: 0.45rem;
  }

  .product-card__details,
  .product-card__add {
    display: inline-flex;
    min-height: 2.45rem;
    align-items: center;
    justify-content: center;
    padding: 0.58rem 0.72rem;
    border: 1px solid var(--line-strong);
    border-radius: 0.55rem;
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
  }

  .product-card__details {
    color: var(--text);
    background: var(--surface-soft);
  }

  .product-card__add {
    color: #fff;
    border-color: var(--brand);
    background: var(--brand);
  }

  .product-card__add[data-added='true'] {
    color: var(--success-text);
    border-color: color-mix(in srgb, var(--success-text) 35%, transparent);
    background: var(--success-bg);
  }

  @keyframes card-rise {
    from {
      opacity: 0;
      transform: translateY(8px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 500px) {
    .product-card__heading,
    .product-card__footer {
      grid-template-columns: 1fr;
    }

    .product-card__availability {
      justify-self: start;
    }

    .product-card__actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .product-card__summary {
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card,
    .product-card__media img {
      animation: none;
      transition: none;
    }
  }
</style>
