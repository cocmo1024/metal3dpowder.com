---
import { siteInfo } from '../data/site';

interface Props {
  pathname: string;
  productsHref?: string;
  contactHref?: string;
}

const { pathname } = Astro.props;
const normalizedPathname = pathname.toLowerCase();

const links = [
  {
    href: '/products/',
    label: 'Powders',
    active: normalizedPathname.startsWith('/products/'),
  },
  {
    href: '/materials/',
    label: 'Materials',
    active: normalizedPathname.startsWith('/materials/'),
  },
  {
    href: '/processes/',
    label: 'Processes',
    active: normalizedPathname.startsWith('/processes/'),
  },
  {
    href: '/applications/',
    label: 'Applications',
    active: normalizedPathname.startsWith('/applications/'),
  },
  {
    href: '/quality/',
    label: 'Quality',
    active: normalizedPathname.startsWith('/quality/'),
  },
  {
    href: '/knowledge/',
    label: 'Engineering',
    active:
      normalizedPathname.startsWith('/knowledge/') ||
      normalizedPathname.startsWith('/comparisons/') ||
      normalizedPathname.startsWith('/blog/') ||
      normalizedPathname.startsWith('/posts/'),
  },
  {
    href: '/about/',
    label: 'About',
    active: normalizedPathname.startsWith('/about/'),
  },
];
---

<div class="utility-bar">
  <div class="utility-bar__inner page-shell">
    <p>Metal powder sourcing for AM, MIM, binder jetting, DED, and powder metallurgy</p>
    <a href="/rfq/">Technical and commercial RFQ support</a>
  </div>
</div>

<header class="site-header" data-site-header data-open="false">
  <div class="site-header__inner page-shell">
    <a class="brand" href="/" aria-label={`${siteInfo.brand} home`}>
      <span class="brand__mark" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
      <span class="brand__text">
        <strong>METAL 3D</strong>
        <small>POWDER</small>
      </span>
    </a>

    <nav class="site-nav site-nav--desktop" aria-label="Primary">
      {
        links.map((link) => (
          <a href={link.href} aria-current={link.active ? 'page' : undefined} data-active={link.active ? 'true' : 'false'}>
            {link.label}
          </a>
        ))
      }
    </nav>

    <a class="rfq-nav" href="/rfq/" aria-current={normalizedPathname.startsWith('/rfq/') ? 'page' : undefined}>
      <span>RFQ list</span>
      <span class="rfq-nav__count" data-rfq-count data-empty>0</span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-drawer" data-nav-toggle>
      <span class="nav-toggle__lines" aria-hidden="true"><span></span><span></span><span></span></span>
      <span>Menu</span>
    </button>
  </div>
</header>

<button class="drawer-backdrop" type="button" aria-label="Close menu" tabindex="-1" data-nav-close></button>

<aside
  class="site-drawer"
  id="mobile-drawer"
  role="dialog"
  aria-modal="true"
  aria-label="Mobile navigation"
  aria-hidden="true"
  data-drawer
>
  <div class="site-drawer__header">
    <p>Product navigation</p>
    <button class="site-drawer__close" type="button" aria-label="Close menu" data-nav-close>
      <span></span><span></span>
    </button>
  </div>

  <nav class="site-drawer__nav" aria-label="Mobile primary">
    {
      links.map((link) => (
        <a
          href={link.href}
          aria-current={link.active ? 'page' : undefined}
          data-active={link.active ? 'true' : 'false'}
          data-drawer-link
        >
          {link.label}
        </a>
      ))
    }
    <a class="site-drawer__rfq" href="/rfq/" data-drawer-link>
      <span>Open RFQ list</span>
      <span data-rfq-count data-empty>0</span>
    </a>
  </nav>
</aside>

<script>
  const header = document.querySelector('[data-site-header]');

  if (header instanceof HTMLElement) {
    const toggle = header.querySelector('[data-nav-toggle]');
    const drawer = document.querySelector('[data-drawer]');
    const closeButtons = document.querySelectorAll('[data-nav-close], [data-drawer-link]');
    let lastFocusedElement: HTMLElement | null = null;
    let lockedScrollY = 0;
    let scrollLocked = false;
    let previousRootOverflow = '';
    let previousBodyStyles: {
      overflow: string;
      position: string;
      top: string;
      left: string;
      right: string;
      width: string;
    } | null = null;

    const setPageScrollLocked = (locked: boolean) => {
      if (locked === scrollLocked) return;

      if (locked) {
        lockedScrollY = window.scrollY;
        previousRootOverflow = document.documentElement.style.overflow;
        previousBodyStyles = {
          overflow: document.body.style.overflow,
          position: document.body.style.position,
          top: document.body.style.top,
          left: document.body.style.left,
          right: document.body.style.right,
          width: document.body.style.width,
        };
        document.documentElement.style.overflow = 'hidden';
        document.body.style.overflow = 'hidden';
        document.body.style.position = 'fixed';
        document.body.style.top = `-${lockedScrollY}px`;
        document.body.style.left = '0';
        document.body.style.right = '0';
        document.body.style.width = '100%';
        scrollLocked = true;
        return;
      }

      document.documentElement.style.overflow = previousRootOverflow;
      if (previousBodyStyles) {
        Object.assign(document.body.style, previousBodyStyles);
      }
      scrollLocked = false;

      const previousScrollBehavior = document.documentElement.style.scrollBehavior;
      document.documentElement.style.scrollBehavior = 'auto';
      window.scrollTo(0, lockedScrollY);
      document.documentElement.style.scrollBehavior = previousScrollBehavior;
    };

    const sync = (open: boolean, restoreFocus = true) => {
      if (open && document.activeElement instanceof HTMLElement) lastFocusedElement = document.activeElement;
      header.dataset.open = String(open);
      setPageScrollLocked(open);
      if (toggle instanceof HTMLButtonElement) toggle.setAttribute('aria-expanded', String(open));
      if (drawer instanceof HTMLElement) drawer.setAttribute('aria-hidden', String(!open));

      if (open && drawer instanceof HTMLElement) {
        window.requestAnimationFrame(() => {
          const firstFocusable = drawer.querySelector('button, a[href]');
          if (firstFocusable instanceof HTMLElement) firstFocusable.focus();
        });
      } else if (restoreFocus && lastFocusedElement instanceof HTMLElement) {
        lastFocusedElement.focus();
      }
    };

    if (toggle instanceof HTMLButtonElement) {
      toggle.addEventListener('click', () => sync(header.dataset.open !== 'true'));
    }

    closeButtons.forEach((node) =>
      node.addEventListener('click', () => sync(false, !node.hasAttribute('data-drawer-link')))
    );
    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && header.dataset.open === 'true') {
        event.preventDefault();
        sync(false);
        return;
      }

      if (event.key !== 'Tab' || header.dataset.open !== 'true' || !(drawer instanceof HTMLElement)) return;
      const focusable = Array.from(
        drawer.querySelectorAll<HTMLElement>('button:not([disabled]), a[href]')
      ).filter((node) => node.offsetParent !== null);
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
    window.addEventListener('resize', () => window.innerWidth > 900 && sync(false, false));
  }
</script>

<style>
  .utility-bar {
    color: #dce7f1;
    background: var(--brand-dark);
  }

  .utility-bar__inner {
    display: flex;
    min-height: 2.15rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.75rem;
    letter-spacing: 0.025em;
  }

  .utility-bar p {
    margin: 0;
  }

  .utility-bar a {
    color: #fff;
    font-weight: 700;
  }

  .site-header {
    position: sticky;
    z-index: 40;
    top: 0;
    width: 100%;
    border-bottom: 1px solid rgba(11, 39, 72, 0.1);
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(16px);
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    min-height: 4.75rem;
    align-items: center;
    gap: 1.4rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.68rem;
    white-space: nowrap;
  }

  .brand__mark {
    position: relative;
    display: block;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--brand-dark);
  }

  .brand__mark span {
    position: absolute;
    display: block;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.9);
  }

  .brand__mark span:nth-child(1) {
    top: 0.43rem;
    left: 0.42rem;
    width: 0.58rem;
    height: 0.58rem;
  }

  .brand__mark span:nth-child(2) {
    top: 0.72rem;
    right: 0.38rem;
    width: 0.72rem;
    height: 0.72rem;
  }

  .brand__mark span:nth-child(3) {
    bottom: 0.37rem;
    left: 0.8rem;
    width: 0.66rem;
    height: 0.66rem;
  }

  .brand__text {
    display: grid;
    gap: 0.02rem;
    line-height: 1;
  }

  .brand__text strong {
    color: var(--brand-dark);
    font-size: 0.98rem;
    letter-spacing: 0.055em;
  }

  .brand__text small {
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.22em;
  }

  .site-nav {
    display: flex;
    align-items: center;
    justify-self: center;
    gap: 0.08rem;
  }

  .site-nav a {
    display: inline-flex;
    min-height: 2.65rem;
    align-items: center;
    padding-inline: 0.7rem;
    border-bottom: 2px solid transparent;
    color: #405160;
    font-size: 0.86rem;
    font-weight: 680;
    transition: color 160ms ease, border-color 160ms ease;
  }

  .site-nav a:hover,
  .site-nav a[data-active='true'] {
    color: var(--brand);
    border-bottom-color: var(--brand);
  }

  .rfq-nav {
    display: inline-flex;
    min-height: 2.8rem;
    align-items: center;
    justify-self: end;
    gap: 0.62rem;
    padding: 0.68rem 0.82rem 0.68rem 1rem;
    border-radius: 0.58rem;
    color: #fff;
    background: var(--brand);
    font-size: 0.84rem;
    font-weight: 760;
    box-shadow: 0 8px 20px rgba(21, 86, 148, 0.16);
  }

  .rfq-nav__count,
  .site-drawer__rfq [data-rfq-count] {
    display: inline-flex;
    min-width: 1.4rem;
    height: 1.4rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    color: var(--brand-dark);
    background: #fff;
    font-size: 0.72rem;
  }

  [data-rfq-count][data-empty] {
    opacity: 0.66;
  }

  .nav-toggle,
  .drawer-backdrop,
  .site-drawer {
    display: none;
  }

  @media (max-width: 1040px) {
    .site-header__inner {
      grid-template-columns: auto 1fr auto auto;
    }

    .site-nav {
      display: none;
    }

    .nav-toggle {
      display: inline-flex;
      min-height: 2.8rem;
      align-items: center;
      justify-content: center;
      gap: 0.55rem;
      padding: 0.65rem 0.78rem;
      border: 1px solid var(--line);
      border-radius: 0.58rem;
      color: var(--text);
      background: var(--surface);
      font-size: 0.82rem;
      font-weight: 700;
    }

    .nav-toggle__lines {
      display: grid;
      gap: 0.2rem;
    }

    .nav-toggle__lines span {
      display: block;
      width: 0.95rem;
      height: 2px;
      border-radius: 999px;
      background: currentColor;
    }

    .drawer-backdrop {
      position: fixed;
      z-index: 48;
      inset: 0;
      display: block;
      border: 0;
      padding: 0;
      background: rgba(8, 24, 40, 0.45);
      opacity: 0;
      pointer-events: none;
      transition: opacity 180ms ease;
    }

    .site-drawer {
      position: fixed;
      z-index: 49;
      top: 0;
      right: 0;
      display: grid;
      width: min(84vw, 340px);
      height: 100vh;
      height: 100dvh;
      align-content: start;
      gap: 1rem;
      padding: 1rem;
      border-left: 1px solid var(--line);
      background: var(--surface);
      opacity: 0;
      overflow-y: auto;
      overscroll-behavior: contain;
      visibility: hidden;
      pointer-events: none;
      -webkit-overflow-scrolling: touch;
      transform: translate3d(100%, 0, 0);
      transition: transform 220ms ease, opacity 180ms ease, visibility 0ms linear 220ms;
    }

    .site-drawer__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--line);
    }

    .site-drawer__header p {
      margin: 0;
      color: var(--muted);
      font-size: 0.75rem;
      font-weight: 760;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .site-drawer__close {
      position: relative;
      width: 2.7rem;
      height: 2.7rem;
      border: 1px solid var(--line);
      border-radius: 50%;
      background: var(--surface-soft);
    }

    .site-drawer__close span {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 1rem;
      height: 2px;
      border-radius: 999px;
      background: var(--text);
    }

    .site-drawer__close span:first-child {
      transform: translate(-50%, -50%) rotate(45deg);
    }

    .site-drawer__close span:last-child {
      transform: translate(-50%, -50%) rotate(-45deg);
    }

    .site-drawer__nav {
      display: grid;
      gap: 0.5rem;
    }

    .site-drawer__nav a {
      display: flex;
      min-height: 3.05rem;
      align-items: center;
      justify-content: space-between;
      padding: 0.72rem 0.85rem;
      border: 1px solid var(--line);
      border-radius: 0.62rem;
      color: var(--text);
      background: var(--surface-soft);
      font-size: 0.92rem;
      font-weight: 680;
    }

    .site-drawer__nav a[data-active='true'] {
      color: var(--brand);
      border-color: color-mix(in srgb, var(--brand) 32%, var(--line));
      background: var(--brand-soft);
    }

    .site-drawer__nav .site-drawer__rfq {
      color: #fff;
      border-color: var(--brand);
      background: var(--brand);
    }

    .site-header[data-open='true'] ~ .drawer-backdrop {
      opacity: 1;
      pointer-events: auto;
      touch-action: none;
    }

    .site-header[data-open='true'] ~ .site-drawer {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translate3d(0, 0, 0);
      transition: transform 220ms ease, opacity 180ms ease, visibility 0ms;
    }
  }

  @media (max-width: 680px) {
    .utility-bar {
      display: none;
    }

    .site-header__inner {
      min-height: 4.25rem;
      grid-template-columns: 1fr auto;
      gap: 0.7rem;
    }

    .rfq-nav {
      display: none;
    }

    .brand__mark {
      width: 2rem;
      height: 2rem;
    }

    .brand__mark span:nth-child(1) {
      top: 0.38rem;
      left: 0.36rem;
    }

    .brand__mark span:nth-child(2) {
      top: 0.62rem;
      right: 0.32rem;
    }

    .brand__mark span:nth-child(3) {
      bottom: 0.32rem;
      left: 0.68rem;
    }
  }
</style>
