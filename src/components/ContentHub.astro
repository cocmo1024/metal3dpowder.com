---
import type { BlogPost } from '../data/blog';
import type { Product } from '../data/products';
import type { BreadcrumbItem } from '../data/seo';
import BlogPostGrid from './BlogPostGrid.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import HubCardGrid from './HubCardGrid.astro';
import ProductRouteGrid from './ProductRouteGrid.astro';
import RfqCta from './RfqCta.astro';

interface HubCard {
  title: string;
  description: string;
  href: string;
}

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  cards?: HubCard[];
  products?: Product[];
  productsTitle?: string;
  posts?: BlogPost[];
  postsTitle?: string;
  breadcrumbItems?: BreadcrumbItem[];
  intentLayer?: 'material-family' | 'process' | 'application' | 'directory';
}

const {
  eyebrow,
  title,
  description,
  cards = [],
  products = [],
  productsTitle = 'Powder routes for this topic',
  posts = [],
  postsTitle = 'Related articles',
  breadcrumbItems = [],
  intentLayer = 'directory',
} = Astro.props;
---

<main id="main-content" class="page-shell hub-page" data-intent-layer={intentLayer}>
  {breadcrumbItems.length ? <Breadcrumbs items={breadcrumbItems} /> : null}

  <section class="hub-intro">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p>{description}</p>
  </section>

  {cards.length ? <HubCardGrid items={cards} ariaLabel={`${title} sections`} /> : null}

  {
    products.length ? (
      <ProductRouteGrid
        products={products}
        title={productsTitle}
        description="Use these as candidate routes, not automatic approvals. The quotation confirms source, grade, PSD, evidence scope, quantity, and delivery terms."
      />
    ) : null
  }

  {
    posts.length ? (
      <section class="hub-section" aria-labelledby="hub-posts-title">
        <h2 id="hub-posts-title">{postsTitle}</h2>
        <BlogPostGrid posts={posts} ariaLabel={postsTitle} headingLevel={3} />
      </section>
    ) : null
  }

  <RfqCta context={title} variant="hub" />
</main>

<style>
  .hub-page {
    display: grid;
    gap: var(--page-gap);
    padding-block: var(--page-padding-block);
  }

  .hub-intro {
    display: grid;
    gap: 0.65rem;
    max-width: 58rem;
  }

  .hub-intro h1 {
    margin: 0;
    font-size: clamp(1.68rem, 2.7vw, 2.14rem);
    line-height: 1.12;
    letter-spacing: var(--title-tracking);
    font-weight: 730;
  }

  .hub-intro p:last-child {
    margin: 0;
    color: var(--muted);
    line-height: var(--body-leading);
  }

  .hub-section {
    display: grid;
    gap: 1rem;
  }

  .hub-section h2 {
    margin: 0;
    font-size: 1.12rem;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  @media (max-width: 720px) {
    .hub-page {
      gap: var(--mobile-page-gap);
      padding-block: var(--mobile-page-padding-block);
    }

    .hub-intro h1 {
      font-size: clamp(1.46rem, 6.2vw, 1.86rem);
      line-height: 1.12;
    }
  }
</style>
