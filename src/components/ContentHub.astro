---
import { getBlogPostPath, type BlogPost } from '../data/blog';
import type { HubDefinition } from '../data/contentHubs';
import type { Product } from '../data/products';
import type { BreadcrumbItem } from '../data/seo';
import BlogPostGrid from './BlogPostGrid.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import HubCardGrid from './HubCardGrid.astro';
import ProductRouteGrid from './ProductRouteGrid.astro';
import RfqCta from './RfqCta.astro';

interface HubCard {
  title: string;
  description: string;
  href: string;
}

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  cards?: HubCard[];
  products?: Product[];
  productsTitle?: string;
  posts?: BlogPost[];
  postsTitle?: string;
  breadcrumbItems?: BreadcrumbItem[];
  intentLayer?: 'material-family' | 'process' | 'application' | 'directory';
  decisionGuide?: HubDefinition['decisionGuide'];
}

const {
  eyebrow,
  title,
  description,
  cards = [],
  products = [],
  productsTitle = 'Powder routes for this topic',
  posts = [],
  postsTitle = 'Related articles',
  breadcrumbItems = [],
  intentLayer = 'directory',
  decisionGuide,
} = Astro.props;
const featuredPosts = posts.slice(0, 12);
const additionalPosts = posts.slice(12);
const featuredCards = cards.slice(0, 12);
const additionalCards = cards.slice(12);
---

<main id="main-content" class="page-shell hub-page" data-intent-layer={intentLayer}>
  {breadcrumbItems.length ? <Breadcrumbs items={breadcrumbItems} /> : null}

  <section class="hub-intro">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p>{description}</p>
  </section>

  {
    decisionGuide ? (
      <section class="hub-decision" aria-labelledby="hub-decision-title">
        <header>
          <p class="eyebrow">Buyer decision framework</p>
          <h2 id="hub-decision-title">{decisionGuide.title}</h2>
          <p>{decisionGuide.introduction}</p>
        </header>
        <div class="hub-decision__grid">
          {decisionGuide.checkpoints.map((checkpoint, index) => (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{checkpoint.title}</h3>
              <p>{checkpoint.description}</p>
            </article>
          ))}
        </div>
        <p class="hub-decision__conclusion">{decisionGuide.conclusion}</p>
      </section>
    ) : null
  }

  {featuredCards.length ? <HubCardGrid items={featuredCards} ariaLabel={`${title} sections`} /> : null}
  {
    additionalCards.length ? (
      <details class="hub-more-sections">
        <summary>Browse {additionalCards.length} more application and industry routes</summary>
        <ul>
          {additionalCards.map((card) => (
            <li>
              <a href={card.href}>{card.title}</a>
              <span>{card.description}</span>
            </li>
          ))}
        </ul>
      </details>
    ) : null
  }

  {
    products.length ? (
      <ProductRouteGrid
        products={products}
        title={productsTitle}
        description="Use these as candidate routes, not automatic approvals. The quotation confirms source, grade, PSD, evidence scope, quantity, and delivery terms."
      />
    ) : null
  }

  {
    posts.length ? (
      <section class="hub-section" aria-labelledby="hub-posts-title">
        <h2 id="hub-posts-title">{postsTitle}</h2>
        <BlogPostGrid posts={featuredPosts} ariaLabel={postsTitle} headingLevel={3} />
        {
          additionalPosts.length ? (
            <details class="hub-more-guides">
              <summary>Browse {additionalPosts.length} more technical guides</summary>
              <ul>
                {additionalPosts.map((post) => (
                  <li><a href={getBlogPostPath(post)}>{post.data.title}</a></li>
                ))}
              </ul>
            </details>
          ) : null
        }
      </section>
    ) : null
  }

  <RfqCta context={title} variant="hub" />
</main>

<style>
  .hub-page {
    display: grid;
    gap: var(--page-gap);
    padding-block: var(--page-padding-block);
  }

  .hub-intro {
    display: grid;
    gap: 0.65rem;
    max-width: 64rem;
  }

  .hub-intro h1 {
    margin: 0;
    font-size: var(--title-hub);
    line-height: 1.06;
    letter-spacing: var(--title-tracking);
    font-weight: 760;
  }

  .hub-intro p:last-child {
    margin: 0;
    color: var(--muted);
    line-height: var(--body-leading);
    font-size: 1.08rem;
  }

  .hub-section {
    display: grid;
    gap: 1rem;
  }

  .hub-section h2 {
    margin: 0;
    font-size: 1.55rem;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .hub-decision {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.35rem, 2.6vw, 2rem);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-card-lg);
    background: linear-gradient(145deg, var(--surface) 0%, var(--surface-soft) 100%);
    box-shadow: var(--shadow-card);
  }

  .hub-decision header {
    display: grid;
    gap: 0.6rem;
    max-width: 52rem;
  }

  .hub-decision h2,
  .hub-decision h3,
  .hub-decision p {
    margin: 0;
  }

  .hub-decision h2 {
    font-size: clamp(1.45rem, 2.5vw, 2rem);
    line-height: 1.17;
    letter-spacing: -0.026em;
  }

  .hub-decision header > p:last-child,
  .hub-decision article p,
  .hub-decision__conclusion {
    color: var(--copy);
    line-height: var(--body-leading);
  }

  .hub-more-guides {
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
  }

  .hub-more-sections {
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }

  .hub-more-sections summary {
    padding: 1rem 1.1rem;
    color: var(--brand);
    font-size: 0.94rem;
    font-weight: 760;
    cursor: pointer;
  }

  .hub-more-sections ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0 1rem 1rem;
    list-style: none;
  }

  .hub-more-sections li {
    display: grid;
    gap: 0.25rem;
    padding: 0.8rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface-soft);
  }

  .hub-more-sections a {
    font-weight: 750;
  }

  .hub-more-sections span {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .hub-more-guides summary {
    padding: 0.95rem 1rem;
    color: var(--brand);
    font-size: 0.94rem;
    font-weight: 760;
    cursor: pointer;
  }

  .hub-more-guides ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.55rem 1.25rem;
    margin: 0;
    padding: 0 1rem 1rem 2.1rem;
  }

  .hub-more-guides a {
    color: var(--copy);
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .hub-more-guides a:hover {
    color: var(--accent);
  }

  .hub-decision__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .hub-decision article {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.4rem 0.8rem;
    align-content: start;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
  }

  .hub-decision article > span {
    grid-row: 1 / span 2;
    color: var(--accent);
    font-size: 0.86rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .hub-decision h3 {
    font-size: 1.05rem;
    line-height: 1.3;
  }

  .hub-decision article p {
    grid-column: 2;
    font-size: 0.96rem;
  }

  .hub-decision__conclusion {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-weight: 650;
  }

  @media (max-width: 720px) {
    .hub-page {
      gap: var(--mobile-page-gap);
      padding-block: var(--mobile-page-padding-block);
    }

    .hub-intro h1 {
      font-size: var(--title-hub);
      line-height: 1.08;
    }

    .hub-decision__grid {
      grid-template-columns: 1fr;
    }

    .hub-more-guides ul {
      grid-template-columns: 1fr;
    }

    .hub-more-sections ul {
      grid-template-columns: 1fr;
    }
  }
</style>
