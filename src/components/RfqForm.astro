---
import { products } from '../data/products';

const turnstileSiteKey =
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '0x4AAAAAAD8DKRg_009r4GGl';
const productPayload = products.map((product) => ({
  id: product.id,
  name: product.name,
  code: product.code,
  family: product.familyLabel,
  processes: product.processes,
  particleSizes: product.particleSizes,
}));
---

<section class="rfq-form-section" aria-labelledby="rfq-form-title">
  <div class="rfq-form-section__intro">
    <p class="eyebrow">Structured powder RFQ</p>
    <h2 id="rfq-form-title">Provide the details needed for an accurate quotation.</h2>
    <p>
      Select one or more catalog products, or describe a custom grade. Price, lead time, source, documents, and available
      lot are confirmed against the complete request.
    </p>

    <div class="rfq-expectations">
      <article>
        <span>01</span>
        <div>
          <strong>Technical triage</strong>
          <p>Grade, process, PSD, quantity, destination, and acceptance needs are reviewed together.</p>
        </div>
      </article>
      <article>
        <span>02</span>
        <div>
          <strong>Specification review</strong>
          <p>Documents and supply status are tied to the quoted source, with lot evidence where applicable.</p>
        </div>
      </article>
      <article>
        <span>03</span>
        <div>
          <strong>Qualification scope</strong>
          <p>No catalog label is treated as finished-part qualification or regulatory approval.</p>
        </div>
      </article>
    </div>

    <aside>
      <strong>Text-only online RFQ</strong>
      <p>State standards, chemistry and PSD limits, document needs, acceptance criteria, equipment, and delivery needs.</p>
      <small>If documents are required later, we will arrange the appropriate channel after initial review.</small>
    </aside>
  </div>

  <div class="rfq-form-card">
    <form
      action="/api/rfq"
      method="post"
      data-rfq-form
      data-turnstile-site-key={turnstileSiteKey}
      data-product-catalog={JSON.stringify(productPayload)}
      novalidate
    >
      <fieldset class="product-selection">
        <legend>Powder selection</legend>
        <p>Add products from the catalog, use the selector below, or describe a custom requirement.</p>

        <div class="selected-products" data-selected-products aria-live="polite"></div>
        <p class="selection-note">
          The main process and quantity apply to all selected products unless you set a different process, particle
          size, or quantity for an item.
        </p>

        <div class="product-picker">
          <label>
            <span>Add a catalog product</span>
            <select data-product-picker>
              <option value="">Choose a powder grade</option>
              {products.map((product) => <option value={product.id}>{product.name} · {product.code}</option>)}
            </select>
          </label>
          <button type="button" data-product-picker-add>Add product</button>
        </div>

        <label>
          <span>Custom grade, chemistry, or open material request</span>
          <input
            name="material_request"
            type="text"
            maxlength="240"
            placeholder="Example: 316L to ASTM F3184, or nickel alloy with a custom 20–63 μm route"
          />
        </label>
      </fieldset>

      <div class="form-grid">
        <label>
          <span>Your name <em aria-hidden="true">*</em></span>
          <input name="name" type="text" autocomplete="name" maxlength="80" required />
        </label>

        <label>
          <span>Work email <em aria-hidden="true">*</em></span>
          <input name="email" type="email" autocomplete="email" maxlength="254" required />
        </label>

        <label>
          <span>Company <em aria-hidden="true">*</em></span>
          <input name="company" type="text" autocomplete="organization" maxlength="120" required />
        </label>

        <label>
          <span>Destination country or region <em aria-hidden="true">*</em></span>
          <input name="country" type="text" autocomplete="country-name" maxlength="80" required />
        </label>

        <label>
          <span>Application <em aria-hidden="true">*</em></span>
          <select name="application" required>
            <option value="">Select the closest fit</option>
            <option value="Aerospace and space">Aerospace and space</option>
            <option value="Medical and dental">Medical and dental</option>
            <option value="Energy and propulsion">Energy and propulsion</option>
            <option value="Tooling and mold">Tooling and mold</option>
            <option value="Electronics and thermal">Electronics and thermal</option>
            <option value="Automotive and transportation">Automotive and transportation</option>
            <option value="Industrial equipment">Industrial equipment</option>
            <option value="Research and material development">Research and material development</option>
            <option value="Other application">Other application</option>
          </select>
        </label>

        <label>
          <span>Target process <em aria-hidden="true">*</em></span>
          <select name="process" required>
            <option value="">Select a process</option>
            <option value="Not decided">Not decided</option>
            <option value="LPBF">LPBF</option>
            <option value="EBM">EBM</option>
            <option value="DED">DED</option>
            <option value="Binder jet">Binder jet</option>
            <option value="MIM">MIM</option>
            <option value="HIP">HIP</option>
            <option value="Other process">Other process</option>
          </select>
        </label>

        <label>
          <span>Particle-size requirement</span>
          <input name="particle_size" type="text" maxlength="100" placeholder="Applies unless a product has a different requirement" />
        </label>

        <label>
          <span>Quantity and annual demand <em aria-hidden="true">*</em></span>
          <input
            name="quantity"
            type="text"
            maxlength="100"
            placeholder="Example: 20 kg trial; 500 kg/year"
            required
          />
        </label>

        <label>
          <span>Packaging or handling requirements</span>
          <input
            name="packaging"
            type="text"
            maxlength="160"
            placeholder="Example: 5 kg bottles, argon packed, or supplier standard"
          />
        </label>

        <label>
          <span>Project timing <em aria-hidden="true">*</em></span>
          <select name="timing" required>
            <option value="">Select timing</option>
            <option value="Exploring feasibility">Exploring feasibility</option>
            <option value="Quote needed within 2 weeks">Quote needed within 2 weeks</option>
            <option value="Material needed within 1–3 months">Material needed within 1–3 months</option>
            <option value="Material needed within 3–6 months">Material needed within 3–6 months</option>
            <option value="Production planning">Production planning</option>
          </select>
        </label>
      </div>

      <label class="full-field">
        <span>Requirements and acceptance criteria <em aria-hidden="true">*</em></span>
        <textarea
          name="requirements"
          rows="7"
          minlength="30"
          maxlength="5000"
          placeholder="Describe the equipment, alloy standard, chemistry limits, PSD method, flow/density needs, documents, qualification stage, delivery target, and any critical failure conditions."
          required></textarea>
      </label>

      <div class="honeypot" aria-hidden="true">
        <label>
          Website
          <input name="website" type="text" tabindex="-1" autocomplete="off" />
        </label>
      </div>

      <input name="products" type="hidden" value="[]" />
      <input name="started_at" type="hidden" value="" />
      <input name="submission_id" type="hidden" value="" />
      <input name="source_page" type="hidden" value="" />
      <input name="attribution" type="hidden" value="" />

      {
        turnstileSiteKey ? (
          <div class="turnstile-row">
            <div
              class="cf-turnstile"
              data-sitekey={turnstileSiteKey}
              data-theme="light"
              data-size="flexible"
              data-action="rfq_submit"
            />
          </div>
        ) : null
      }

      <label class="consent-row">
        <input name="consent" type="checkbox" value="accepted" required />
        <span>
          I confirm that these details may be used to review and respond to this RFQ under the
          <a href="/privacy/" target="_blank" rel="noopener noreferrer">Privacy Policy</a>.
        </span>
      </label>

      <div class="submit-row">
        <button class="button button--primary" type="submit" data-rfq-submit>Submit powder RFQ</button>
        <p aria-live="polite" data-rfq-status>
          You’ll receive an on-screen reference after submission.
        </p>
      </div>
    </form>

    <div class="rfq-success" role="status" data-rfq-success hidden>
      <span>RFQ accepted</span>
      <h3>Your powder request is ready for technical and commercial review.</h3>
      <p>
        Keep the reference below for follow-up. Replies and formal quotations will come from the official corporate
        email.
      </p>
      <strong data-rfq-reference></strong>
      <a class="button button--ghost" href="/products/">Continue browsing powders</a>
    </div>
  </div>
</section>

{turnstileSiteKey ? <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js" /> : null}

<script is:inline>
  (() => {
    const form = document.querySelector('[data-rfq-form]');
    if (!(form instanceof HTMLFormElement) || form.dataset.rfqBound === 'true') return;
    form.dataset.rfqBound = 'true';

    const storageKey = 'metal3dpowder:rfq-products';
    const productCatalog = (() => {
      try {
        return JSON.parse(form.dataset.productCatalog || '[]');
      } catch {
        return [];
      }
    })();
    const productMap = new Map(productCatalog.map((product) => [product.id, product]));
    const productPicker = form.querySelector('[data-product-picker]');
    const productPickerAdd = form.querySelector('[data-product-picker-add]');
    const selectedProducts = form.querySelector('[data-selected-products]');
    const productsInput = form.elements.namedItem('products');
    const submitButton = form.querySelector('[data-rfq-submit]');
    const status = form.querySelector('[data-rfq-status]');
    const successPanel = form.parentElement?.querySelector('[data-rfq-success]');
    const reference = successPanel?.querySelector('[data-rfq-reference]');
    const sourcePage = form.elements.namedItem('source_page');
    const startedAt = form.elements.namedItem('started_at');
    const submissionId = form.elements.namedItem('submission_id');
    const attributionInput = form.elements.namedItem('attribution');
    const defaultStatus = status?.textContent?.trim() || '';
    const defaultSubmitText = submitButton?.textContent?.trim() || 'Submit powder RFQ';
    let rfqStarted = false;
    let selectedIds = [];
    const itemSelections = new Map();
    const escapeAttribute = (value) =>
      String(value || '').replace(
        /[&<>"']/g,
        (character) =>
          ({
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#39;',
          })[character]
      );

    const readStoredProducts = () => {
      try {
        const stored = JSON.parse(window.localStorage.getItem(storageKey) || '[]');
        return Array.isArray(stored) ? stored.filter((id) => productMap.has(id)) : [];
      } catch {
        return [];
      }
    };

    const writeStoredProducts = () => {
      try {
        window.localStorage.setItem(storageKey, JSON.stringify(selectedIds));
      } catch {
        // Storage can be unavailable in strict privacy modes; the in-page RFQ list still works.
      }
      window.dispatchEvent(new CustomEvent('metal3dpowder:rfq-change'));
    };

    const setStatus = (message, isError = false) => {
      if (!status) return;
      status.textContent = message;
      status.toggleAttribute('data-error', isError);
    };

    const syncProductsInput = () => {
      if (productsInput instanceof HTMLInputElement) {
        productsInput.value = JSON.stringify(
          selectedIds.map((id) => ({
            id,
            process: itemSelections.get(id)?.process || '',
            particleSize: itemSelections.get(id)?.particleSize || '',
            quantity: itemSelections.get(id)?.quantity || '',
          }))
        );
      }
    };

    const renderSelectedProducts = () => {
      syncProductsInput();
      if (!selectedProducts) return;

      if (!selectedIds.length) {
        selectedProducts.innerHTML =
          '<p class="selected-products__empty">No catalog product selected. Add one below or describe a custom material request.</p>';
        return;
      }

      selectedProducts.innerHTML = selectedIds
        .map((id) => {
          const product = productMap.get(id);
          const item = itemSelections.get(id) || {};
          const processOptions = ['Not decided', ...product.processes.filter((value) => value !== 'Not decided')]
            .map(
              (value) =>
                `<option value="${escapeAttribute(value)}" ${item.process === value ? 'selected' : ''}>${escapeAttribute(value)}</option>`
            )
            .join('');
          const particleOptions = ['Not decided', ...product.particleSizes, 'Other / custom']
            .map(
              (value) =>
                `<option value="${escapeAttribute(value)}" ${item.particleSize === value ? 'selected' : ''}>${escapeAttribute(value)}</option>`
            )
            .join('');
          return `<div class="selected-product">
            <div class="selected-product__heading">
              <span><strong>${escapeAttribute(product.name)}</strong><small>${escapeAttribute(product.code)} · ${escapeAttribute(product.family)}</small></span>
              <button type="button" data-remove-product="${escapeAttribute(id)}" aria-label="Remove ${escapeAttribute(product.name)}">Remove</button>
            </div>
            <div class="selected-product__fields">
              <label>
                <span>Process (if different)</span>
                <select aria-label="Process for ${escapeAttribute(product.name)}" data-item-id="${escapeAttribute(id)}" data-item-field="process">
                  <option value="">Use main process</option>
                  ${processOptions}
                </select>
              </label>
              <label>
                <span>Particle size (if different)</span>
                <select aria-label="Particle size for ${escapeAttribute(product.name)}" data-item-id="${escapeAttribute(id)}" data-item-field="particleSize">
                  <option value="">Use main particle size</option>
                  ${particleOptions}
                </select>
              </label>
              <label>
                <span>Quantity (if different)</span>
                <input aria-label="Quantity for ${escapeAttribute(product.name)}" data-item-id="${escapeAttribute(id)}" data-item-field="quantity" maxlength="100" value="${escapeAttribute(item.quantity)}" placeholder="Use main quantity" />
              </label>
            </div>
          </div>`;
        })
        .join('');
    };

    const addProduct = (id) => {
      if (!productMap.has(id) || selectedIds.includes(id)) return;
      selectedIds = [...selectedIds, id];
      itemSelections.set(id, {});
      writeStoredProducts();
      renderSelectedProducts();
    };

    const query = new URLSearchParams(window.location.search);
    selectedIds = readStoredProducts();
    const queryProduct = query.get('product');
    if (queryProduct && productMap.has(queryProduct) && !selectedIds.includes(queryProduct)) {
      selectedIds.push(queryProduct);
    }
    const queryMaterial = query.get('material');
    const materialRequest = form.elements.namedItem('material_request');
    if (
      queryMaterial &&
      materialRequest instanceof HTMLInputElement &&
      !materialRequest.value.trim()
    ) {
      materialRequest.value = queryMaterial;
    }
    writeStoredProducts();
    renderSelectedProducts();

    productPickerAdd?.addEventListener('click', () => {
      if (productPicker instanceof HTMLSelectElement && productPicker.value) {
        addProduct(productPicker.value);
        productPicker.value = '';
      }
    });

    selectedProducts?.addEventListener('click', (event) => {
      const button = event.target instanceof Element ? event.target.closest('[data-remove-product]') : null;
      const id = button?.getAttribute('data-remove-product');
      if (!id) return;
      selectedIds = selectedIds.filter((selectedId) => selectedId !== id);
      itemSelections.delete(id);
      writeStoredProducts();
      renderSelectedProducts();
    });

    selectedProducts?.addEventListener('input', (event) => {
      const field = event.target instanceof HTMLElement ? event.target.closest('[data-item-field]') : null;
      const id = field?.getAttribute('data-item-id');
      const key = field?.getAttribute('data-item-field');
      if (!id || !key || !selectedIds.includes(id)) return;
      const value =
        field instanceof HTMLInputElement || field instanceof HTMLSelectElement ? field.value.slice(0, 100) : '';
      itemSelections.set(id, { ...(itemSelections.get(id) || {}), [key]: value });
      syncProductsInput();
    });

    const refreshContext = (resetStartedAt = false) => {
      if (resetStartedAt && startedAt instanceof HTMLInputElement) startedAt.value = String(Date.now());
      if (submissionId instanceof HTMLInputElement && !submissionId.value) {
        submissionId.value = crypto.randomUUID();
      }
      if (sourcePage instanceof HTMLInputElement) sourcePage.value = window.location.href;

      const storedAttribution = (() => {
        try {
          return JSON.parse(window.localStorage.getItem('metal3dpowder:attribution') || '{}');
        } catch {
          return {};
        }
      })();
      if (attributionInput instanceof HTMLInputElement) {
        attributionInput.value = JSON.stringify(storedAttribution);
      }
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      refreshContext();

      const materialRequest = form.elements.namedItem('material_request');
      if (
        !selectedIds.length &&
        materialRequest instanceof HTMLInputElement &&
        materialRequest.value.trim().length < 2
      ) {
        materialRequest.setCustomValidity('Select a catalog product or describe the material requirement.');
      } else if (materialRequest instanceof HTMLInputElement) {
        materialRequest.setCustomValidity('');
      }

      if (!form.checkValidity()) {
        form.reportValidity();
        setStatus('Please complete the required fields.', true);
        return;
      }

      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = true;
        submitButton.textContent = 'Sending RFQ…';
      }
      setStatus('Securely sending your project…');

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new URLSearchParams(new FormData(form)),
          headers: { Accept: 'application/json' },
          credentials: 'same-origin',
        });
        const result = await response.json().catch(() => ({}));

        if (!response.ok || result.accepted !== true || !result.submissionId) {
          throw new Error(result.message || 'The RFQ could not be accepted. Please email info@szcomo.com.');
        }

        form.hidden = true;
        if (successPanel instanceof HTMLElement) successPanel.hidden = false;
        if (reference) reference.textContent = `Reference: ${result.submissionId}`;
        try {
          window.localStorage.removeItem(storageKey);
        } catch {
          // The accepted RFQ should not be downgraded because local storage is unavailable.
        }
        window.dispatchEvent(new CustomEvent('metal3dpowder:rfq-change'));
        window.dispatchEvent(
          new CustomEvent('metal3dpowder:track', {
            detail: {
              event: 'generate_lead',
              submission_id: String(result.submissionId),
              product_count: selectedIds.length,
              products: selectedIds.join(','),
              source_path: window.location.pathname,
            },
          })
        );
        successPanel?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch (error) {
        setStatus(error instanceof Error ? error.message : 'The RFQ could not be accepted.', true);
        if (window.turnstile && typeof window.turnstile.reset === 'function') window.turnstile.reset();
        if (submitButton instanceof HTMLButtonElement) {
          submitButton.disabled = false;
          submitButton.textContent = defaultSubmitText;
        }
      }
    });

    form.addEventListener('input', () => {
      if (!rfqStarted) {
        rfqStarted = true;
        window.dispatchEvent(
          new CustomEvent('metal3dpowder:track', {
            detail: {
              event: 'begin_rfq',
              product_count: selectedIds.length,
              products: selectedIds.join(','),
              source_path: window.location.pathname,
            },
          })
        );
      }
      if (status?.hasAttribute('data-error')) setStatus(defaultStatus);
    });

    refreshContext(true);
  })();
</script>

<style>
  .rfq-form-section {
    display: grid;
    grid-template-columns: minmax(18rem, 0.65fr) minmax(0, 1.35fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .rfq-form-section__intro {
    position: sticky;
    top: 6.5rem;
    display: grid;
    gap: 1rem;
  }

  .rfq-form-section__intro h2 {
    max-width: 32rem;
    margin: 0;
    font-size: clamp(2rem, 3.6vw, 3.15rem);
    line-height: 1.04;
    letter-spacing: -0.045em;
  }

  .rfq-form-section__intro > p:not(.eyebrow) {
    max-width: 35rem;
    margin: 0;
    color: var(--muted);
    line-height: 1.7;
  }

  .rfq-expectations {
    display: grid;
    gap: 0.65rem;
  }

  .rfq-expectations article {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.7rem;
    padding-block: 0.75rem;
    border-top: 1px solid var(--line);
  }

  .rfq-expectations article > span {
    color: var(--brand);
    font-size: 0.7rem;
    font-weight: 800;
  }

  .rfq-expectations article div {
    display: grid;
    gap: 0.2rem;
  }

  .rfq-expectations strong {
    font-size: 0.9rem;
  }

  .rfq-expectations p {
    margin: 0;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .rfq-form-section__intro aside {
    display: grid;
    gap: 0.35rem;
    padding: 1rem;
    border-left: 3px solid var(--accent);
    color: #fff;
    background: var(--brand-dark);
  }

  .rfq-form-section__intro aside p,
  .rfq-form-section__intro aside small {
    margin: 0;
    color: #b7c8d7;
    line-height: 1.5;
  }

  .rfq-form-section__intro aside p {
    font-size: 0.8rem;
  }

  .rfq-form-section__intro aside small {
    font-size: 0.7rem;
  }

  .rfq-form-card {
    padding: clamp(1.2rem, 3vw, 2rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }

  .rfq-form-card form {
    display: grid;
    gap: 1.2rem;
  }

  .product-selection {
    display: grid;
    gap: 0.8rem;
    margin: 0;
    padding: 0 0 1.2rem;
    border: 0;
    border-bottom: 1px solid var(--line);
  }

  .product-selection legend {
    margin-bottom: 0.3rem;
    color: var(--text);
    font-size: 1.05rem;
    font-weight: 760;
  }

  .product-selection > p {
    margin: 0;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .product-selection .selection-note {
    padding-left: 0.7rem;
    border-left: 2px solid var(--brand);
    font-size: 0.8125rem;
  }

  .selected-products {
    display: grid;
    gap: 0.45rem;
  }

  :global([data-selected-products] .selected-products__empty) {
    margin: 0;
    padding: 0.75rem;
    border: 1px dashed var(--line-strong);
    border-radius: 0.65rem;
    color: var(--muted);
    background: var(--surface-soft);
    font-size: 0.8125rem;
  }

  :global([data-selected-products] .selected-product) {
    display: grid;
    gap: 0.85rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    border-radius: 0.65rem;
    background: var(--brand-soft);
  }

  :global([data-selected-products] .selected-product__heading) {
    display: flex;
    gap: 0.8rem;
    align-items: start;
    justify-content: space-between;
  }

  :global([data-selected-products] .selected-product__heading > span) {
    display: grid;
    gap: 0.12rem;
    min-width: 0;
  }

  :global([data-selected-products] .selected-product strong) {
    font-size: 0.88rem;
    line-height: 1.3;
  }

  :global([data-selected-products] .selected-product small) {
    color: var(--muted);
    font-size: 0.72rem;
    line-height: 1.4;
  }

  :global([data-selected-products] .selected-product__heading button) {
    flex: 0 0 auto;
    min-height: 2rem;
    padding: 0.35rem 0.55rem;
    border: 1px solid var(--line-strong);
    border-radius: 0.45rem;
    color: var(--brand);
    background: var(--surface);
    font-size: 0.72rem;
    font-weight: 750;
    cursor: pointer;
  }

  :global([data-selected-products] .selected-product__fields) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.65rem;
  }

  :global([data-selected-products] .selected-product__fields label) {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }

  :global([data-selected-products] .selected-product__fields label > span) {
    color: var(--muted);
    font-size: 0.72rem;
